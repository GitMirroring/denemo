msgstr "Atzīmē/noņem atzīmi akordam vai notij pie kursora kā diminuendo sākumu."

#: ../src/core/entries.h:193
msgid "End Diminuendo (Off/On)"
msgstr "Diminuendo beigas (izsl./iesl.)"

