msgid "Edit Start Brace"
msgstr "Rediģēt sākuma figūriekavu"

#: ../src/ui/mousing.c:1397
msgid "Edit End Brace"
msgstr "Rediģēt beigu figūriekavu"

#: ../src/ui/mousing.c:1412
msgid "This staff grouping has no End Brace so it finishes on the lowest staff. Use the Staffs/Voices->Staff Groupings menu to place an End Brace on the desired staff"
msgstr "Šim nošu līniju grupējumam nav beigu figūriekavas, tāpēc tas beidzas pie apakšējās nošu līnijas. Lai vēlamajā nošu līnijā novietotu beigu figūriekavu, izmantojiet izvēlni Nošu līnijas/balsis->Nošu līniju grupējumi"

#: ../src/ui/mousing.c:1432
msgid "Click on Staff Directives."
msgstr "Klikšķis uz nošu līnijas direktīvām."

#: ../src/ui/mousing.c:1432
msgid "This pops up the staff directives menu for editing"
msgstr "Tas atver nošu līnijas direktīvu izvēlni rediģēšanai"

