#: ../actions/menus/MainMenu/EditMenu/Delete/DeleteDirective.scm:22
msgid " at cursor."
msgstr " pie kursora."

#: ../actions/menus/MainMenu/EditMenu/Delete/DeleteDirective.scm:24
msgid "No Directive at Cursor Position"
msgstr "Kursora pozīcijā nav direktīvas"

#: ../actions/menus/MainMenu/EditMenu/Delete/DeleteDirective.xml.h:1
msgid "Delete Directive at Cursor."
msgstr "Dzēst direktīvu pie kursora."

#: ../actions/menus/MainMenu/EditMenu/Delete/DeleteDirective.xml.h:2
msgid "Deletes a Denemo Directive at the cursor. This may be a standalone directive or one attached to a object. Position the cursor at the note height when the directive is attached to just one note in a chord, alternatively not at a note height if the directive is attached to the chord as a whole."
msgstr "Dzēš Denemo direktīvu pie kursora. Tā var būt atsevišķa direktīva vai objektam pievienota. Novietojiet kursoru nots augstumā, ja direktīva pievienota tikai vienai akorda notij, vai ne nots augstumā, ja direktīva pievienota visam akordam."

#: ../actions/menus/MainMenu/EditMenu/Delete/IntelligentDelete.xml.h:1
msgid "Delete Selection/Object/Empty Measure"
msgstr "Dzēst atlasi/objektu/tukšu takti"

#: ../actions/menus/MainMenu/EditMenu/Delete/IntelligentDelete.xml.h:2
msgid "Deletes a single object at the cursor, an empty measure or the complete selection."
msgstr "Dzēš vienu objektu pie kursora, tukšu takti vai visu atlasi."

#. RemoveCustomizedButtons
#: ../actions/menus/MainMenu/EditMenu/Delete/RemoveSchemeInit.xml.h:1
msgid "Destroy Button Customization"
msgstr "Iznīcināt pogu pielāgojumus"

#: ../actions/menus/MainMenu/EditMenu/Delete/RemoveSchemeInit.xml.h:2
msgid "Removes the file that creates customized buttons on the title bar (and any other scheme you have added to the startup script)."
msgstr "Noņem failu, kas izveido pielāgotās pogas virsraksta joslā (un jebkuru citu startēšanas skriptam pievienoto Scheme)."

#: ../actions/menus/MainMenu/EditMenu/Delete/StagedDelete.xml.h:1
msgid "Delete in Stages"
msgstr "Dzēst pakāpeniski"

#: ../actions/menus/MainMenu/EditMenu/Delete/StagedDelete.xml.h:2
msgid "Deletes the object at/before the cursor. For Notes/Chords/Rests it deletes stage by stage. First it removes notes until just a non-printing rest remains, then deletes that."
msgstr "Dzēš objektu pie kursora/pirms tā. Notīm/akordiem/pauzēm dzēš pakāpeniski. Vispirms noņem notis, līdz paliek tikai nedrukājama pauze, un pēc tam to izdzēš."

#: ../actions/menus/MainMenu/EditMenu/EditAll.scm:7
msgid "Delete All "
msgstr "Dzēst visus "

#: ../actions/menus/MainMenu/EditMenu/EditAll.scm:8
msgid "Execute Scheme on all "
msgstr "Izpildīt Scheme visiem "

#: ../actions/menus/MainMenu/EditMenu/EditAll.scm:11
msgid "You must choose a type of object to edit first"
msgstr "Vispirms jāizvēlas rediģējamā objekta tips"

#: ../actions/menus/MainMenu/EditMenu/EditAll.xml.h:1
msgid "Edit All of Type"
msgstr "Rediģēt visus šā tipa"

#: ../actions/menus/MainMenu/EditMenu/EditAll.xml.h:2
msgid "Resumes the last Seeking/Editing/Deleting operation. All objects of the type last searched for will be sought again, from the cursor onwards."
msgstr "Atsāk pēdējo meklēšanas/rediģēšanas/dzēšanas darbību. Visi pēdējoreiz meklētā tipa objekti tiks meklēti vēlreiz, sākot no kursora."

#. EditScoreAndMovementDirectives
#: ../actions/menus/MainMenu/EditMenu/EditScoreAndMovementDirectives.xml.h:1
msgid "Edit Score/Movement Directives"
msgstr "Rediģēt partitūras/daļas direktīvas"

#: ../actions/menus/MainMenu/EditMenu/EditScoreAndMovementDirectives.xml.h:2
msgid "Collects together all the Score Directives and the Movement Directives for the current movement and allows advanced (low-level) edit of any of them. This is a convenience command if you do not know the directive you are looking for."
msgstr "Apkopo visas partitūras direktīvas un pašreizējās daļas direktīvas un ļauj jebkuru no tām rediģēt paplašināti (zemā līmenī). Ērtības komanda, ja nezināt, kuru direktīvu meklējat."

