msgstr "Atslēgas maiņa"

#: ../src/core/entries.h:293
msgid "Insert/Edit a change of clef at the cursor"
msgstr "Ievietot/rediģēt atslēgas maiņu pie kursora"

#: ../src/core/entries.h:294
msgid "Keys"
msgstr "Toņkārtas"

#: ../src/core/entries.h:294
msgid ""
"Menu:\n"
"Set the key signature or insert a change of key signature\n"
"Sharpen or flatten a key signature or\n"
"hide it on printing"
msgstr ""
"Izvēlne:\n"
"Iestatīt toņkārtu vai ievietot toņkārtas maiņu\n"
"Paaugstināt vai pazemināt toņkārtu vai\n"
"paslēpt to drukājot"

#: ../src/core/entries.h:295
msgid "Initial Key"
msgstr "Sākotnējā toņkārta"

#: ../src/core/entries.h:295
msgid "Set the initial key signature of the current staff"
msgstr "Iestatīt pašreizējās nošu līnijas sākotnējo toņkārtu"

#. GUI setup
#: ../src/core/entries.h:296 ../src/ui/keysigdialog.c:384
msgid "Key Signature Change"
msgstr "Toņkārtas maiņa"

#: ../src/core/entries.h:296 ../actions/palettes.xml.h:11
