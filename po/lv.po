msgstr "Sāciet vilkt, lai mainītu MIDI ierakstītā celiņa tempu."

#: ../src/ui/mousing.c:1156
msgid "Shift Left click on MIDI Recording Track"
msgstr "Shift+kreisais klikšķis uz MIDI ieraksta celiņa"

#: ../src/ui/mousing.c:1156
