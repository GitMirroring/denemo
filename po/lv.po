#: ../actions/menus/ObjectMenu/Score/Typesetter/ScoreRehearsalMarkFormat.xml.h:2
msgid "Select the format of rehearsal marks (alphabetic, numeric, boxed, etc.)"
msgstr "Izvēlieties mēģinājuma zīmju formātu (burtu, skaitļu, rāmī u. c.)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:101
msgid "Add to current rules"
msgstr "Pievienot pašreizējiem noteikumiem"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:102
msgid "Replace current rules"
msgstr "Aizstāt pašreizējos noteikumus"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:103
msgid "Delete (and revert to default rules)"
msgstr "Dzēst (un atgriezties pie noklusējuma noteikumiem)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:125
msgid "Beaming Rules added from the selection"
msgstr "Svītrošanas noteikumi pievienoti no atlases"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:131
#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:152
msgid "Beaming Rules replaced with ones from the selection"
msgstr "Svītrošanas noteikumi aizstāti ar noteikumiem no atlases"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:136
msgid "Beaming Rules added from the selections have been dropped"
msgstr "No atlasēm pievienotie svītrošanas noteikumi atmesti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:154
msgid "Set Beaming rule for "
msgstr "Iestatīt svītrošanas noteikumu — "

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:155
msgid "Delete Beaming rule for "
msgstr "Dzēst svītrošanas noteikumu — "

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:156
msgid "Delete All (and revert to default rules)"
msgstr "Dzēst visus (un atgriezties pie noklusējuma noteikumiem)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:162
msgid "Give beat"
msgstr "Ievadiet sitienu"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:168
msgid "Chosen duration does not fit time signature"
msgstr "Izvēlētais ilgums neatbilst taktsmēram"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:172
msgid "Beat Structure"
msgstr "Sitienu struktūra"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:172
msgid "Give groupings for "
msgstr "Ievadiet grupējumus — "

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.scm:172
msgid " beats: "
msgstr " sitieni: "

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.xml.h:1
msgid "Set Beaming Rules"
msgstr "Iestatīt svītrošanas noteikumus"

#: ../actions/menus/ObjectMenu/Score/Typesetter/SetBeamExceptions.xml.h:2
msgid "Sets the rules to be used for beaming. With no selection gets the beat for beams to be divided for the prevailing time signature at the cursor. If a there is a selection this will be used as the set of rules. In this case indicate the beaming desired using the manual beam commands [ and ], giving all the beaming rules wanted using several measures if needed (no other rules are used). Repeat with different selections to add further rules."
msgstr "Iestata svītrošanai izmantojamos noteikumus. Ja atlases nav, iegūst sitienu, pēc kura sadalīt svītras pašreizējam taktsmēram pie kursora. Ja ir atlase, tā tiks izmantota kā noteikumu kopa. Šādā gadījumā norādiet vēlamo svītrojumu ar manuālajām svītru komandām [ un ], ja nepieciešams, norādot visus vajadzīgos svītrošanas noteikumus vairākās taktīs (citi noteikumi netiek izmantoti). Lai pievienotu vēl noteikumus, atkārtojiet ar citām atlasēm."

#: ../actions/menus/ObjectMenu/Score/Typesetter/StaccatoStaccatissimo.xml.h:1
msgid "Staccato as '"
msgstr "Staccato kā '"

#: ../actions/menus/ObjectMenu/Score/Typesetter/StaccatoStaccatissimo.xml.h:2
msgid "Typesets staccato in 18th c. style, similar to modern stacattissimo. Applies to whole score."
msgstr "Saliek staccato 18. gs. stilā, līdzīgi mūsdienu staccatissimo. Attiecas uz visu partitūru."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TieWaitForNote.xml.h:1
msgid "Ties Extend to Matching Note"
msgstr "Līgas stiepjas līdz atbilstošajai notij"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TieWaitForNote.xml.h:2
msgid "Ties will extend over intermediate notes until the note tied to occurs. Use for written-out arpeggio styles."
msgstr "Līgas stiepsies pāri starpnotīm, līdz parādīsies nots, ar kuru saistīts. Izmantojiet izrakstīta arpedžo stiliem."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TinyStaffAllMovements.xml.h:1
msgid "Tiny Staff in All Movements"
msgstr "Ļoti maza nošu līnija visās daļās"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TinyStaffAllMovements.xml.h:2
msgid "Gets a staff number 1 ... n from user and makes that staff tiny in all movements."
msgstr "Prasa lietotājam nošu līnijas numuru 1 ... n un padara šo nošu līniju ļoti mazu visās daļās."

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleCurveControl.scm:15
msgid "Curve Control Points On"
msgstr "Līkņu vadības punkti ieslēgti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleCurveControl.scm:16
msgid ""
"Typeset score will have curves marked with control points\n"
"Use these for accurate reshaping of curves via wysiwyg operations on the typeset score with mouse"
msgstr ""
"Saliktajā partitūrā līknes būs atzīmētas ar vadības punktiem\n"
"Izmantojiet tos precīzai līkņu formas maiņai ar WYSIWYG darbībām, ar peli darbojoties saliktajā partitūrā"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleCurveControl.xml.h:1
msgid "Typeset Curve Control Points (Off/On)"
msgstr "Salikt līkņu vadības punktus (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleCurveControl.xml.h:2
msgid "Typesets with curve control points marked. Use these for accurate tweaking of shape via clicking and dragging with mouse on final typeset score."
msgstr "Saliek ar atzīmētiem līkņu vadības punktiem. Izmantojiet tos precīzai formas precizēšanai, klikšķinot un velkot ar peli galīgajā saliktajā partitūrā."

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFigures.scm:6
msgid "Bass Figures will be typeset"
msgstr "Basa cipari tiks salikti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFigures.scm:12
msgid "Bass Figures will not be typeset"
msgstr "Basa cipari netiks salikti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFigures.xml.h:1
msgid "Bass Figures (Off/On)"
msgstr "Basa cipari (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFigures.xml.h:2
msgid "Turns on/off visibility of figured bass on typesetting for whole score."
msgstr "Ieslēdz/izslēdz ģenerālbasa redzamību salikumā visai partitūrai."

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFingeringVisibilityInScore.scm:6
msgid "Fingerings will be typeset"
msgstr "Pirkstu apzīmējumi tiks salikti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFingeringVisibilityInScore.scm:9
msgid "Fingerings will be not typeset"
msgstr "Pirkstu apzīmējumi netiks salikti"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFingeringVisibilityInScore.xml.h:1
msgid "Fingerings (Off/On)"
msgstr "Pirkstu apzīmējumi (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleFingeringVisibilityInScore.xml.h:2
msgid "Turns on/off visibility of fingerings on typesetting for whole score."
msgstr "Ieslēdz/izslēdz pirkstu apzīmējumu redzamību salikumā visai partitūrai."

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleWysiwygMarks.scm:16
msgid "Wysiwyg Marks On"
msgstr "WYSIWYG zīmes ieslēgtas"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleWysiwygMarks.scm:17
msgid ""
"Typeset score will have graphical objects marked with red dots\n"
"Use these for accurate tweaking of positions via wysiwyg operations on the typeset score with mouse"
msgstr ""
"Saliktajā partitūrā grafiskie objekti būs atzīmēti ar sarkaniem punktiem\n"
"Izmantojiet tos precīzai pozīciju precizēšanai ar WYSIWYG darbībām, ar peli darbojoties saliktajā partitūrā"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleWysiwygMarks.xml.h:1
msgid "Typeset Red Dots (Off/On)"
msgstr "Salikt sarkanos punktus (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/ToggleWysiwygMarks.xml.h:2
msgid "Typesets with red dots on the graphical objects. Use these for accurate tweaking of positions via clicking and dragging with mouse on final typeset score."
msgstr "Saliek ar sarkaniem punktiem uz grafiskajiem objektiem. Izmantojiet tos precīzai pozīciju precizēšanai, klikšķinot un velkot ar peli galīgajā saliktajā partitūrā."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOctaveUp.scm:2
msgid "Print out 8va up"
msgstr "Izdrukāt 8va augstāk"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOctaveUp.xml.h:1
msgid "(Print) Transpose Octave Up"
msgstr "(Druka) Transponēt oktāvu augstāk"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOctaveUp.xml.h:2
msgid "Instructs the LilyPond Engraver to transpose this score one octave up."
msgstr "Liek LilyPond gravētājam transponēt šo partitūru oktāvu augstāk."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOnPrint.scm:3
msgid "Transpose Score"
msgstr "Transponēt partitūru"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOnPrint.scm:3
msgid "Transpose Staff"
msgstr "Transponēt nošu līniju"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOnPrint.scm:5
msgid "--- Transpose to -->"
msgstr "--- Transponēt uz -->"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOnPrint.xml.h:1
msgid "Transpose on Print (Graphical Interface)"
msgstr "Transponēt drukājot (grafiskā saskarne)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeOnPrint.xml.h:2
msgid "Gets an interval from the user: the entire score is transposed by this interval on typesetting - key signatures are transposed as well as notes and chord symbols."
msgstr "Iegūst no lietotāja intervālu: salikšanas laikā visa partitūra tiek transponēta par šo intervālu — tiek transponētas toņkārtas, kā arī notis un akordu simboli."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeScorePrint.scm:51
msgid ""
"Give Interval to transpose by as two note names, \n"
"     for example \"c g\" means transpose 5th up.\n"
"    Note names are in Dutch!!! a,b,c ... are the same but\n"
"    \"es\" = flat, so e.g. bes means b-flat\n"
"    \"is\" = sharp so e.g fis means f-sharp\n"
"    Use commas for octave(s) down, \n"
"    single-quotes for octave(s) up\n"
"    e.g. c c' means octave up.\n"
"    You do not have to start with c\n"
"    e.g. d e means a tone higher.\n"
"    "
msgstr ""
"Ievadiet transponēšanas intervālu kā divus nošu nosaukumus, \n"
"     piemēram, \"c g\" nozīmē transponēt par kvintu augstāk.\n"
"    Nošu nosaukumi ir holandiešu valodā!!! a,b,c ... ir tādi paši, bet\n"
"    \"es\" = bemols, piem., bes nozīmē b-bemols (B)\n"
"    \"is\" = diēzs, piem., fis nozīmē f-diēzs\n"
"    Oktāvu(-as) zemāk apzīmē ar komatiem, \n"
"    oktāvu(-as) augstāk — ar apostrofiem,\n"
"    piem., c c' nozīmē oktāvu augstāk.\n"
"    Nav jāsāk ar c,\n"
"    piem., d e nozīmē par toni augstāk.\n"
"    "

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeScorePrint.scm:61
msgid "Will be transposed to:"
msgstr "Tiks transponēts uz:"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeScorePrint.xml.h:1
msgid "Transpose on Print (Text Input)"
msgstr "Transponēt drukājot (teksta ievade)"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TransposeScorePrint.xml.h:2
msgid "Typesets the score transposed by the interval you give - key signatures are transposed as well as notes and chord symbols."
msgstr "Saliek partitūru, transponētu par jūsu norādīto intervālu — tiek transponētas toņkārtas, kā arī notis un akordu simboli."

#: ../actions/menus/ObjectMenu/Score/Typesetter/TrillIsPlus.xml.h:1
msgid "Set Trill Style as +"
msgstr "Iestatīt trillera stilu kā +"

#: ../actions/menus/ObjectMenu/Score/Typesetter/TrillIsPlus.xml.h:2
msgid "Prints trills with the common 18th c. notation: a plus sign."
msgstr "Drukā trillerus ierastajā 18. gs. notācijā: ar plusa zīmi."

#: ../actions/menus/ObjectMenu/StaffMenu/CaptureScore/CaptureMeasuresForStaff.xml.h:1
msgid "Capture Measures (one staff)"
msgstr "Tvert taktis (viena nošu līnija)"

#: ../actions/menus/ObjectMenu/StaffMenu/CaptureScore/CaptureMeasuresForStaff.xml.h:2
msgid "Creates blank measures one for each measure captured as a screenshot from one of a set of parts. Display the source score on the screen using any program. Click on opposite corners of each measure in turn to capture that measure as an image into Denemo. Right-click or scroll-wheel to switch corners to adjust. Press any key to finish. This command is for capturing in parts form; to capture in full score use CaptureMeasures command"
msgstr "Izveido tukšas taktis — pa vienai katrai taktij, kas tverta kā ekrānuzņēmums no vienas no partijām. Attēlojiet avota partitūru ekrānā ar jebkuru programmu. Pēc kārtas noklikšķiniet uz katras takts pretējiem stūriem, lai tvertu šo takti kā attēlu Denemo. Lai pārslēgtu stūrus pielāgošanai, izmantojiet labo klikšķi vai ritenīti. Lai beigtu, nospiediet jebkuru taustiņu. Šī komanda paredzēta tveršanai partiju formā; lai tvertu pilnu partitūru, izmantojiet komandu CaptureMeasures"

#: ../actions/menus/ObjectMenu/StaffMenu/CaptureScore/DeleteCapturedMeasureForStaff.xml.h:1
msgid "Delete Captured Measure."
msgstr "Dzēst tverto takti."

#: ../actions/menus/ObjectMenu/StaffMenu/CaptureScore/DeleteCapturedMeasureForStaff.xml.h:2
msgid "Deletes the captured measure image for the current measure of the current staff."
msgstr "Dzēš pašreizējās nošu līnijas pašreizējās takts tverto takts attēlu."

#: ../actions/menus/ObjectMenu/StaffMenu/CaptureScore/InsertCaptureMeasureForStaff.xml.h:2
msgid "Capture the image of a single measure (as screenshot) inserting at the current measure in the current staff."
msgstr "Tvert vienas takts attēlu (kā ekrānuzņēmumu), ievietojot pašreizējā taktī pašreizējā nošu līnijā."

#: ../actions/menus/ObjectMenu/StaffMenu/ChangeStaff.xml.h:1
msgid "Change Staff"
msgstr "Mainīt nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/ChangeStaff.xml.h:2
#: ../actions/palettes.xml.h:36
msgid "(Print) the current voice moves to the staff you name."
msgstr "(Druka) pašreizējā balss pārvietojas uz jūsu nosaukto nošu līniju."

#: ../actions/menus/ObjectMenu/StaffMenu/CheckTiesInStaff.scm:20
msgid "Tied notes not the same"
msgstr "Ar līgu saistītās notis nav vienādas"

#: ../actions/menus/ObjectMenu/StaffMenu/CheckTiesInStaff.scm:41
msgid "All ties in this staff are correctly placed"
msgstr "Visas šīs nošu līnijas līgas ir novietotas pareizi"

#: ../actions/menus/ObjectMenu/StaffMenu/CheckTiesInStaff.xml.h:1
msgid "Check Ties"
msgstr "Pārbaudīt līgas"

#: ../actions/menus/ObjectMenu/StaffMenu/CheckTiesInStaff.xml.h:2
msgid "Checks for wrongly tied notes in the current voice/staff."
msgstr "Pārbauda, vai pašreizējā balsī/nošu līnijā nav nepareizi ar līgu saistītu nošu."

#: ../actions/menus/ObjectMenu/StaffMenu/CreateCuesForStaff.xml.h:1
msgid "Create Cues"
msgstr "Izveidot norādes"

#: ../actions/menus/ObjectMenu/StaffMenu/CreateCuesForStaff.xml.h:2
msgid "Goes through the staff looking for long rests. Creates a cue in the whole measure rest."
msgstr "Pārskata nošu līniju, meklējot garas pauzes. Visas takts pauzē izveido norādi."

#: ../actions/menus/ObjectMenu/StaffMenu/CrossStaffArpeggio.scm:7
msgid "Arpeggios will not cross staffs"
msgstr "Arpedžo nešķērsos nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/CrossStaffArpeggio.scm:9
msgid "Arpeggios will cross staffs"
msgstr "Arpedžo šķērsos nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/CrossStaffArpeggio.scm:10
msgid " Cross Staff Arpeggios "
msgstr " Arpedžo pāri nošu līnijām "

#: ../actions/menus/ObjectMenu/StaffMenu/CrossStaffArpeggio.xml.h:1
msgid "Cross Staff Arpeggio"
msgstr "Arpedžo pāri nošu līnijām"

#: ../actions/menus/ObjectMenu/StaffMenu/CrossStaffArpeggio.xml.h:2
msgid "(Print) Allow arpeggio sign to extend across staffs. Piano staffs obey this by default, other staff groups need the Span_arpeggio_engraver including in the Score context for it to work."
msgstr "(Druka) Ļaut arpedžo zīmei stiepties pāri nošu līnijām. Klavieru nošu līnijas to ievēro pēc noklusējuma; citām nošu līniju grupām, lai tas darbotos, partitūras kontekstā jāiekļauj Span_arpeggio_engraver."

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteCurrentStaff.xml.h:1
msgid "Delete Current Staff/Voice"
msgstr "Dzēst pašreizējo nošu līniju/balsi"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteCurrentStaff.xml.h:2
msgid "Deletes current staff (if the action is confirmed by the user)."
msgstr "Dzēš pašreizējo nošu līniju (ja lietotājs darbību apstiprina)."

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteFromCursorToEnd.scm:4
#: ../actions/menus/ObjectMenu/StaffMenu/DeleteMeasuresBeforeCursor.scm:4
msgid "All Staffs - Delete all measures from cursor?"
msgstr "Visas nošu līnijas — dzēst visas taktis no kursora?"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteFromCursorToEnd.scm:4
#: ../actions/menus/ObjectMenu/StaffMenu/DeleteMeasuresBeforeCursor.scm:4
msgid "This Staff/Voice only?"
msgstr "Tikai šī nošu līnija/balss?"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteFromCursorToEnd.xml.h:1
msgid "Delete Measures From Cursor"
msgstr "Dzēst taktis no kursora"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteFromCursorToEnd.xml.h:2
msgid "Deletes all measures from the cursor to the end, either in one or all staffs."
msgstr "Dzēš visas taktis no kursora līdz beigām vienā vai visās nošu līnijās."

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteMeasuresBeforeCursor.xml.h:1
msgid "Delete Measures Before Cursor"
msgstr "Dzēst taktis pirms kursora"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteMeasuresBeforeCursor.xml.h:2
msgid "Deletes all the measures before the measure containing the cursor, either current staff or all staffs as chosen by user."
msgstr "Dzēš visas taktis pirms takts, kurā ir kursors, pašreizējā vai visās nošu līnijās — pēc lietotāja izvēles."

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteTextAnnotationsFromCursor.xml.h:1
msgid "Delete Text Annotations"
msgstr "Dzēst teksta anotācijas"

#: ../actions/menus/ObjectMenu/StaffMenu/DeleteTextAnnotationsFromCursor.xml.h:2
msgid "Deletes standalone text annotations from the cursor to the end of the staff."
msgstr "Dzēš atsevišķas teksta anotācijas no kursora līdz nošu līnijas beigām."

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/HideNotSelectedStaffs.xml.h:1
msgid "Hide Non-Selected Staffs."
msgstr "Slēpt neatlasītās nošu līnijas."

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/HideNotSelectedStaffs.xml.h:2
msgid "Hides staffs that are not selected in the Denemo Display. Does not affect the typesetting."
msgstr "Slēpj Denemo attēlojumā neatlasītās nošu līnijas. Neietekmē salikumu."

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/HideSelectedStaffs.xml.h:1
msgid "Hides Selected Staffs"
msgstr "Slēpj atlasītās nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/HideSelectedStaffs.xml.h:2
msgid "Hides the selected staffs in the Denemo Display. Does not affect the Typesetting."
msgstr "Slēpj atlasītās nošu līnijas Denemo attēlojumā. Neietekmē salikumu."

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/ToggleCurrentStaffDisplay.xml.h:1
msgid "Staff Hidden (Off/On)"
msgstr "Nošu līnija paslēpta (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/ToggleCurrentStaffDisplay.xml.h:2
msgid "Shows/Hides the current staff in the Denemo Display. Does not affect the typesetting."
msgstr "Rāda/slēpj pašreizējo nošu līniju Denemo attēlojumā. Neietekmē salikumu."

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/ToggleDisplayAllStaffs.xml.h:1
msgid "Display All (Other) Staffs (Off/On)"
msgstr "Rādīt visas (citas) nošu līnijas (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/DisplayEffects/ToggleDisplayAllStaffs.xml.h:2
msgid "Show the current staff in the display and hide/show all other staffs. Typesetting is not affected."
msgstr "Rādīt attēlojumā pašreizējo nošu līniju un slēpt/rādīt visas pārējās. Salikums netiek ietekmēts."

#: ../actions/menus/ObjectMenu/StaffMenu/FillEmptyMeasures.xml.h:1
msgid "Fill Empty Measures"
msgstr "Aizpildīt tukšās taktis"

#: ../actions/menus/ObjectMenu/StaffMenu/FillEmptyMeasures.xml.h:2
msgid "Replaces empty measures from the cursor position onwards with non-printing whole measure rests."
msgstr "Aizstāj tukšās taktis no kursora pozīcijas ar nedrukājamām visas takts pauzēm."

#: ../actions/menus/ObjectMenu/StaffMenu/FixSlursInStaff.xml.h:1
msgid "Fix Slurs"
msgstr "Labot legato līgas"

#: ../actions/menus/ObjectMenu/StaffMenu/FixSlursInStaff.xml.h:2
msgid "Removes incorrectly placed slur start/end markers on current voice/staff."
msgstr "Noņem nepareizi novietotus legato līgu sākuma/beigu marķierus pašreizējā balsī/nošu līnijā."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/AddInstrumentStaff.xml.h:1
msgid "Add Staff for Instrument"
msgstr "Pievienot nošu līniju instrumentam"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/AddInstrumentStaff.xml.h:2
msgid "Adds a staff at the bottom for the instrument selected from the templates/instruments directory. The name and range of the instrument is set with any transposition for playback if needed."
msgstr "Pievieno apakšā nošu līniju instrumentam, kas izvēlēts no direktorijas templates/instruments. Tiek iestatīts instrumenta nosaukums un diapazons un, ja nepieciešams, transpozīcija atskaņošanai."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/AddMirrorStaff.xml.h:1
msgid "Add Staff (Borrowed/Mirrored Music)"
msgstr "Pievienot nošu līniju (aizgūta/spoguļota mūzika)"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/AddMirrorStaff.xml.h:2
msgid "Adds a staff whose music is automatically mirrored from another staff of your choice. Use this e.g. to create a staff with two divisi parts, while keeping the second part as a separate staff, or to typeset both Fret Diagrams and Chord Symbols from the same music. Note that initial clef/key/time are copied not mirrored. Staff number to mirror is chosen interactively or passed as a parameter to the command."
msgstr "Pievieno nošu līniju, kuras mūzika tiek automātiski spoguļota no citas jūsu izvēlētas nošu līnijas. Izmantojiet to, piem., lai izveidotu nošu līniju ar divām divisi partijām, saglabājot otro partiju kā atsevišķu nošu līniju, vai lai no vienas mūzikas saliktu gan grifa diagrammas, gan akordu simbolus. Ņemiet vērā, ka sākotnējā atslēga/toņkārta/taktsmērs tiek kopēti, nevis spoguļoti. Spoguļojamās nošu līnijas numurs tiek izvēlēts interaktīvi vai nodots komandai kā parametrs."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CouleStaff.scm:4
msgid "This staff creates notes drawn as a diagonal line. Use these to create a coule between two notes another part."
msgstr "Šī nošu līnija veido notis, kas zīmētas kā slīpa līnija. Izmantojiet tās, lai izveidotu coulé starp divām citas partijas notīm."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CouleStaff.xml.h:1
msgid "Add Staff for Coulés"
msgstr "Pievienot nošu līniju coulé"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CouleStaff.xml.h:2
msgid "Adds a voice to the current staff which typesets notes as a slanting line - a coulé. The main voice provides the chord notes, and this provides the coulé between them."
msgstr "Pievieno pašreizējai nošu līnijai balsi, kas saliek notis kā slīpu līniju — coulé. Galvenā balss nodrošina akorda notis, bet šī — coulé starp tām."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.scm:8
msgid "Fill in the upbeat in the click track before playing"
msgstr "Pirms atskaņošanas aizpildiet uztakti klikšķu celiņā"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.scm:51
msgid "Populate with these clicks"
msgstr "Aizpildīt ar šiem klikšķiem"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.scm:51
msgid "Play clicks again"
msgstr "Atskaņot klikšķus vēlreiz"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.scm:51
msgid "Edit clicks"
msgstr "Rediģēt klikšķus"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.scm:61
msgid "Edit the clicks and then re-run this command to populate the subsequent empty measures up to any time signature change. Then repeat for each change of time signature."
msgstr "Rediģējiet klikšķus un pēc tam vēlreiz palaidiet šo komandu, lai aizpildītu nākamās tukšās taktis līdz jebkurai taktsmēra maiņai. Pēc tam atkārtojiet katrai taktsmēra maiņai."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.xml.h:1
msgid "Create/Populate Click Staff"
msgstr "Izveidot/aizpildīt klikšķu nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/CreateClickStaff.xml.h:2
msgid "Creates a staff at the top as a click track. Suggests a pattern of drum beats for the first bar, and offers to copy these to the following bars. The cursor height determines which drum sounds are suggested from the General MIDI set. Invoked in a click track it will copy your own set of drum beats to subsequent (empty) measures."
msgstr "Izveido augšā nošu līniju kā klikšķu celiņu. Iesaka bungu sitienu rakstu pirmajai taktij un piedāvā to kopēt nākamajās taktīs. Kursora augstums nosaka, kuras bungu skaņas no General MIDI kopas tiek ieteiktas. Izsaukta klikšķu celiņā, tā kopēs jūsu bungu sitienu kopu nākamajās (tukšajās) taktīs."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/DynamicsStaff.scm:32
msgid ""
"This line (\"staff\") is for holding cresc. dim hairpins and dynamic markings so that they can be positioned (using dummy notes, colored blue) and will align with each other. Create this between the staffs for a piano work or on any staff where alignment of hairpins and dynamic marks is needed.\n"
"WARNING: Do not place clef changes or other non-duration items in this staff - it may trigger the creation of a separate staff on typesetting!\n"
"This Dynamics \"staff\" must have the same part name as the staff the dynamics should appear on."
msgstr ""
"Šī līnija („nošu līnija”) paredzēta cresc./dim. dakšām un dinamikas apzīmējumiem, lai tos varētu novietot (izmantojot fiktīvas, zilas notis) un tie būtu savstarpēji līdzināti. Izveidojiet to starp klavierskaņdarba nošu līnijām vai jebkurā nošu līnijā, kur nepieciešams dakšu un dinamikas zīmju līdzinājums.\n"
"BRĪDINĀJUMS: nenovietojiet šajā nošu līnijā atslēgas maiņas vai citus vienumus bez ilguma — tas salikšanas laikā var izraisīt atsevišķas nošu līnijas izveidi!\n"
"Šai dinamikas „nošu līnijai” jābūt ar tādu pašu partijas nosaukumu kā nošu līnijai, pie kuras jāparādās dinamikai."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/DynamicsStaff.xml.h:1
msgid "Add Staff for Dynamics"
msgstr "Pievienot nošu līniju dinamikai"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/DynamicsStaff.xml.h:2
msgid "This line (\"staff\") is for holding cresc. dim hairpins and dynamic markings so that they can be positioned (using dummy notes, colored blue) and will align with each other.\\nCreate this between the staffs for a piano work or on any staff where alignment of hairpins and dynamic marks is needed. WARNING: Do not start/end staff-groupings on this staff. Do not place clef changes or other non-duration items in this staff - it may trigger the creation of a separate staff on typesetting! This Dynamics \"staff\" must have the same part name as the staff the dynamics should appear on."
msgstr "Šī līnija („nošu līnija”) paredzēta cresc./dim. dakšām un dinamikas apzīmējumiem, lai tos varētu novietot (izmantojot fiktīvas, zilas notis) un tie būtu savstarpēji līdzināti.\\nIzveidojiet to starp klavierskaņdarba nošu līnijām vai jebkurā nošu līnijā, kur nepieciešams dakšu un dinamikas zīmju līdzinājums. BRĪDINĀJUMS: nesāciet/nebeidziet šajā nošu līnijā nošu līniju grupējumus. Nenovietojiet šajā nošu līnijā atslēgas maiņas vai citus vienumus bez ilguma — tas salikšanas laikā var izraisīt atsevišķas nošu līnijas izveidi! Šai dinamikas „nošu līnijai” jābūt ar tādu pašu partijas nosaukumu kā nošu līnijai, pie kuras jāparādās dinamikai."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MarksStaff.scm:22
msgid ""
"This staff is purely for holding marks that should appear once at the top of the system - avoiding having to put the marks in each part. It must have a blank part name, so that it is typeset with every part. The marks should be spaced using either dummy notes or spacers.\n"
"   WARNING: Do not place clef changes or other non-duration items in this staff - it may trigger the creation of a separate staff on typesetting!"
msgstr ""
"Šī nošu līnija paredzēta tikai zīmēm, kurām jāparādās vienreiz sistēmas augšā — lai tās nebūtu jāievieto katrā partijā. Tai jābūt ar tukšu partijas nosaukumu, lai tā tiktu salikta ar katru partiju. Zīmes jāizvieto, izmantojot fiktīvas notis vai atstarpes.\n"
"   BRĪDINĀJUMS: nenovietojiet šajā nošu līnijā atslēgas maiņas vai citus vienumus bez ilguma — tas salikšanas laikā var izraisīt atsevišķas nošu līnijas izveidi!"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MarksStaff.xml.h:1
msgid "Add Staff for Marks"
msgstr "Pievienot nošu līniju zīmēm"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MarksStaff.xml.h:2
msgid "This staff is purely for holding marks that should appear once at the top of the system - avoiding having to put the marks in each part. It must have a blank part name, so that it is typeset with every part. The marks should be spaced using either dummy notes or spacers.\\nWARNING: Do not start/end staff-groupings on this staff. Do not place clef changes etc in this staff - they may trigger the creation of a separate staff on typesetting!"
msgstr "Šī nošu līnija paredzēta tikai zīmēm, kurām jāparādās vienreiz sistēmas augšā — lai tās nebūtu jāievieto katrā partijā. Tai jābūt ar tukšu partijas nosaukumu, lai tā tiktu salikta ar katru partiju. Zīmes jāizvieto, izmantojot fiktīvas notis vai atstarpes.\\nBRĪDINĀJUMS: nesāciet/nebeidziet šajā nošu līnijā nošu līniju grupējumus. Nenovietojiet šajā nošu līnijā atslēgas maiņas u. c. — tās salikšanas laikā var izraisīt atsevišķas nošu līnijas izveidi!"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/CreateClickStaffForMidi.scm:80
msgid "Click Track Creation"
msgstr "Klikšķu celiņa izveide"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/CreateClickStaffForMidi.scm:80
msgid "Give number of measures required: "
msgstr "Ievadiet vajadzīgo taktu skaitu: "

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/CreateClickStaffForMidi.xml.h:1
msgid "Create Click Track Staff"
msgstr "Izveidot klikšķu celiņa nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/CreateClickStaffForMidi.xml.h:2
msgid "Creates a staff (a click track) at the top of this score from the imported MIDI file, using tempo and time signature information (if present). The measures are filled with drum beats so that pitches in the MIDI tracks can be displayed above them. When you have finished the import you can delete this staff."
msgstr "Izveido šīs partitūras augšā nošu līniju (klikšķu celiņu) no importētā MIDI faila, izmantojot tempa un taktsmēra informāciju (ja ir). Taktis tiek aizpildītas ar bungu sitieniem, lai virs tiem varētu attēlot MIDI celiņu skaņu augstumus. Kad imports pabeigts, šo nošu līniju var izdzēst."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.scm:11
msgid "MIDI Track Selection"
msgstr "MIDI celiņa izvēle"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.scm:12
msgid "Select track to import"
msgstr "Izvēlieties importējamo celiņu"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.scm:23
msgid "Out of range"
msgstr "Ārpus diapazona"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.scm:25
#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/NextMidiTrack.scm:7
#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/PreviousMidiTrack.scm:7
msgid "No MIDI file loaded"
msgstr "Nav ielādēts MIDI fails"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.xml.h:1
msgid "Insert Staff for MIDI Track"
msgstr "Ievietot nošu līniju MIDI celiņam"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/LoadMidiTrack.xml.h:2
msgid "Creates a staff below the click track for the MIDI track selected. The staff is empty except for time signature and tempo changes. The MIDI pitches from the track are displayed above the click track and notes can be inserted by double-clicking on a MIDI pitch and entering the rhythm."
msgstr "Izveido zem klikšķu celiņa nošu līniju izvēlētajam MIDI celiņam. Nošu līnija ir tukša, izņemot taktsmēra un tempa maiņas. Celiņa MIDI skaņu augstumi tiek attēloti virs klikšķu celiņa, un notis var ievietot, veicot dubultklikšķi uz MIDI skaņas augstuma un ievadot ritmu."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/NextMidiTrack.scm:6
msgid "This is the last track"
msgstr "Šis ir pēdējais celiņš"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/NextMidiTrack.xml.h:1
msgid "Load Next Midi Track"
msgstr "Ielādēt nākamo MIDI celiņu"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/NextMidiTrack.xml.h:2
#: ../actions/palettes.xml.h:181
msgid "Creates a staff for the next MIDI track after the current one, making that the current one."
msgstr "Izveido nošu līniju nākamajam MIDI celiņam aiz pašreizējā, padarot to par pašreizējo."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/PreviousMidiTrack.scm:6
msgid "This is the first track"
msgstr "Šis ir pirmais celiņš"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/PreviousMidiTrack.xml.h:1
msgid "Load Previous MIDI Track"
msgstr "Ielādēt iepriekšējo MIDI celiņu"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/MIDI/PreviousMidiTrack.xml.h:2
#: ../actions/palettes.xml.h:180
msgid "Creates a staff for the imported MIDI track previous to the current one, making that the current one."
msgstr "Izveido nošu līniju importētajam MIDI celiņam pirms pašreizējā, padarot to par pašreizējo."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffAfter.xml.h:1
msgid "New Staff After Current"
msgstr "Jauna nošu līnija pēc pašreizējās"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffAfter.xml.h:2
msgid "Creates a new staff with the given name, after the current staff. Use the staff to voice command if you want to make this staff a voice on the previous staff."
msgstr "Izveido jaunu nošu līniju ar norādīto nosaukumu aiz pašreizējās nošu līnijas. Ja vēlaties šo nošu līniju padarīt par balsi iepriekšējā nošu līnijā, izmantojiet komandu „Nošu līnija uz balsi”."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffAllMovements.xml.h:1
msgid "Add in All Movements"
msgstr "Pievienot visās daļās"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffAllMovements.xml.h:2
msgid "Adds a new structured staff after the current staff in this and succeeding movments."
msgstr "Pievieno jaunu strukturētu nošu līniju aiz pašreizējās nošu līnijas šajā un nākamajās daļās."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffBefore.xml.h:1
msgid "New Staff Before Current"
msgstr "Jauna nošu līnija pirms pašreizējās"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStaffBefore.xml.h:2
msgid "Creates a new staff with the given name, before the current staff."
msgstr "Izveido jaunu nošu līniju ar norādīto nosaukumu pirms pašreizējās nošu līnijas."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStructuredStaff.xml.h:1
msgid "New Structured Staff"
msgstr "Jauna strukturēta nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/NewStructuredStaff.xml.h:2
msgid "Creates a new staff below the current staff with the same time signature changes inserted."
msgstr "Izveido zem pašreizējās nošu līnijas jaunu nošu līniju ar tādām pašām ievietotām taktsmēra maiņām."

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/PianoStaff.scm:8
msgid "Replace Current Staff?"
msgstr "Aizstāt pašreizējo nošu līniju?"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/PianoStaff.scm:9
msgid "Keep Current Staff"
msgstr "Paturēt pašreizējo nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/PianoStaff.xml.h:1
msgid "Add Piano Staff"
msgstr "Pievienot klavieru nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/InsertStaff/PianoStaff.xml.h:2
#: ../actions/palettes.xml.h:34
msgid "Adds two staff braced together for keyboard instrument."
msgstr "Pievieno taustiņinstrumentam divas ar figūriekavu savienotas nošu līnijas."

#: ../actions/menus/ObjectMenu/StaffMenu/MoveStaffToBottom.xml.h:1
msgid "Staff to Bottom"
msgstr "Nošu līniju uz apakšu"

#: ../actions/menus/ObjectMenu/StaffMenu/MoveStaffToBottom.xml.h:2
msgid "Moves the current staff to become the bottom most staff."
msgstr "Pārvieto pašreizējo nošu līniju, lai tā kļūtu par apakšējo."

#: ../actions/menus/ObjectMenu/StaffMenu/MoveStaffToTop.xml.h:1
msgid "Staff to Top"
msgstr "Nošu līniju uz augšu"

#: ../actions/menus/ObjectMenu/StaffMenu/MoveStaffToTop.xml.h:2
msgid "Moves the current staff to become the topmost staff."
msgstr "Pārvieto pašreizējo nošu līniju, lai tā kļūtu par augšējo."

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/CreateOssiaStaff.xml.h:1
msgid "Create Ossia Staff"
msgstr "Izveidot ossia nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/CreateOssiaStaff.xml.h:2
msgid "Creates a small staff above the current staff for inserting cues, ossia passages etc. Use Show Ossia and Hide Ossia to show specific measures."
msgstr "Izveido virs pašreizējās nošu līnijas mazu nošu līniju norāžu, ossia fragmentu u. c. ievietošanai. Lai rādītu noteiktas taktis, izmantojiet „Rādīt ossia” un „Slēpt ossia”."

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/HideOssia.scm:4
msgid "This marks the end of the passage to be shown on the ossia staff"
msgstr "Tas apzīmē ossia nošu līnijā rādāmā fragmenta beigas"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/HideOssia.xml.h:1
msgid "Hide Ossia"
msgstr "Slēpt ossia"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/HideOssia.xml.h:2
msgid "Place this at the end of the music to be printed from the Ossia staff"
msgstr "Novietojiet to no ossia nošu līnijas drukājamās mūzikas beigās"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/ShowOssia.scm:4
msgid "This marks the start of a passage to be shown on the ossia staff"
msgstr "Tas apzīmē ossia nošu līnijā rādāmā fragmenta sākumu"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/ShowOssia.scm:8
msgid "Show"
msgstr "Rādīt"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/ShowOssia.xml.h:1
msgid "Show Ossia"
msgstr "Rādīt ossia"

#: ../actions/menus/ObjectMenu/StaffMenu/Ossia/ShowOssia.xml.h:2
msgid "Place this at the start of the music to be printed from the Ossia staff"
msgstr "Novietojiet to no ossia nošu līnijas drukājamās mūzikas sākumā"

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/MuteStaff.scm:30
msgid ""
"The volume set on this staff is very low, you may not hear it.\n"
"See Staff->Staff Properties->Built-in Staff Properties, MIDI tab."
msgstr ""
"Šajā nošu līnijā iestatītais skaļums ir ļoti zems, iespējams, to nedzirdēsiet.\n"
"Sk. Nošu līnija->Nošu līnijas īpašības->Iebūvētās nošu līnijas īpašības, cilne MIDI."

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/MuteStaff.xml.h:1
#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SetInitialVolumeToZero.xml.h:1
msgid "Mute"
msgstr "Apklusināt"

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/MuteStaff.xml.h:2
msgid "Mutes the current staff. Affects only playback."
msgstr "Apklusina pašreizējo nošu līniju. Ietekmē tikai atskaņošanu."

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SetInitialVolumeToZero.xml.h:2
msgid "Mutes playback on this staff by placing a volume=zero directive at the start."
msgstr "Apklusina atskaņošanu šajā nošu līnijā, sākumā novietojot direktīvu volume=zero."

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/StaffRemoveCustomDurations.xml.h:1
msgid "Remove Custom Durations (Swing/Graces)"
msgstr "Noņemt pielāgotos ilgumus (svings/priekšnotis)"

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/StaffRemoveCustomDurations.xml.h:2
msgid "Removes the special durations applied by swing and sounding grace notes."
msgstr "Noņem svinga un skanošo priekšnošu piemērotos īpašos ilgumus."

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/StaffSoundGraceNotes.xml.h:1
msgid "Sound Grace Notes"
msgstr "Atskaņot priekšnotis"

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/StaffSoundGraceNotes.xml.h:2
msgid "Grace notes will be played back as appogiature, stealing time from the following note. Not for Playback View which uses LilyPond's MIDI to play back."
msgstr "Priekšnotis tiks atskaņotas kā apodžatūras, atņemot laiku nākamajai notij. Nav paredzēts atskaņošanas skatam, kas atskaņošanai izmanto LilyPond MIDI."

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SwingStaff.scm:31
#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SwingStaff.xml.h:1
msgid "Swing Staff"
msgstr "Svinga nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SwingStaff.scm:31
msgid "Give percentage swing: "
msgstr "Ievadiet svinga procentus: "

#: ../actions/menus/ObjectMenu/StaffMenu/Playback/SwingStaff.xml.h:2
msgid "Changes the playback duration of pairs of 𝅘𝅥𝅮 notes for swing or notes inègales. Does not affect typesetting."
msgstr "Maina 𝅘𝅥𝅮 nošu pāru atskaņošanas ilgumu svingam vai notes inégales. Neietekmē salikumu."

#. clears any extras in the staff-prolog
#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/ClearStaffProlog.xml.h:1
msgid "Normal Staff"
msgstr "Parasta nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/ClearStaffProlog.xml.h:2
msgid "Deletes the extra staff prolog - restoring the normal staff settings."
msgstr "Dzēš papildu nošu līnijas prologu, atjaunojot parastos nošu līnijas iestatījumus."

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/TransposeStaffOutput.scm:7
msgid "No Transposition Interval"
msgstr "Nav transpozīcijas intervāla"

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/TransposeStaffOutput.scm:7
msgid ""
"To use this function you need to place the cursor\n"
"on the first of two notes which define\n"
"the transposition required"
msgstr ""
"Lai izmantotu šo funkciju, novietojiet kursoru\n"
"uz pirmās no divām notīm, kas nosaka\n"
"vajadzīgo transpozīciju"

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/TransposeStaffOutput.scm:7
msgid "Ok"
msgstr "Labi"

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/TransposeStaffOutput.xml.h:1
msgid "Transpose Output"
msgstr "Transponēt izvadi"

#: ../actions/menus/ObjectMenu/StaffMenu/PrintEffects/TransposeStaffOutput.xml.h:2
msgid "Transpose this staff in the print out. The cursor must be on the first of two notes that define the interval to use."
msgstr "Transponēt šo nošu līniju izdrukā. Kursoram jāatrodas uz pirmās no divām notīm, kas nosaka izmantojamo intervālu."

#: ../actions/menus/ObjectMenu/StaffMenu/SimplifyTies.xml.h:1
msgid "Simplify Ties"
msgstr "Vienkāršot līgas"

#: ../actions/menus/ObjectMenu/StaffMenu/SimplifyTies.xml.h:2
msgid "Converts tied notes to longer notes and removes spurious ties."
msgstr "Pārveido ar līgu saistītas notis par garākām notīm un noņem liekās līgas."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffDeleteEmptyMeasures.xml.h:2
msgid "Deletes any measures that are empty from the measure after the cursor to end of staff."
msgstr "Dzēš visas tukšās taktis no takts aiz kursora līdz nošu līnijas beigām."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:5
#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.xml.h:1
msgid "Brace End"
msgstr "Figūriekavas beigas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:10
msgid "Add an End Brace Marker"
msgstr "Pievienot beigu figūriekavas marķieri"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:11
msgid "Delete an End Brace Marker"
msgstr "Dzēst beigu figūriekavas marķieri"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:12
msgid "Move End Brace Marker Up"
msgstr "Pārvietot beigu figūriekavas marķieri uz augšu"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:13
msgid "Move End Brace MarkerDown"
msgstr "Pārvietot beigu figūriekavas marķieri uz leju"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:34
msgid "No staff above"
msgstr "Augstāk nav nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.scm:46
msgid "No staff below"
msgstr "Zemāk nav nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/BraceEnd.xml.h:2
msgid "Add or remove end of staff group marks, or move them to an adjacent staff."
msgstr "Pievienot vai noņemt nošu līniju grupas beigu zīmes vai pārvietot tās uz blakus esošu nošu līniju."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/CheckBraces.scm:39
msgid "Too few staff braces open at staff number "
msgstr "Pārāk maz atvērtu nošu līniju figūriekavu pie nošu līnijas numura "

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/CheckBraces.scm:41
msgid "More staff braces started than are ended."
msgstr "Sākts vairāk nošu līniju figūriekavu nekā beigts."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/CheckBraces.scm:43
msgid "More staff braces ended than are started."
msgstr "Beigts vairāk nošu līniju figūriekavu nekā sākts."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/CheckBraces.xml.h:1
msgid "Check Braces"
msgstr "Pārbaudīt figūriekavas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/CheckBraces.xml.h:2
msgid "Checks the braces (staff groupings) for this movement."
msgstr "Pārbauda šīs daļas figūriekavas (nošu līniju grupējumus)."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/ChoirStaffStart.xml.h:1
msgid "ChoirStaff Start"
msgstr "ChoirStaff sākums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/ChoirStaffStart.xml.h:2
msgid "Start grouping single staves together in order to form multi-stave systems. In a ChoirStaff, the group starts with a bracket, but bar lines are not connected."
msgstr "Sākt grupēt atsevišķas nošu līnijas, lai veidotu vairāku nošu līniju sistēmas. ChoirStaff grupa sākas ar kvadrātiekavu, bet taktsvītras netiek savienotas."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/DeleteStaffGroupings.xml.h:1
msgid "Delete all staff groupings"
msgstr "Dzēst visus nošu līniju grupējumus"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/DeleteStaffGroupings.xml.h:2
msgid "Clear the staff from all groupings"
msgstr "Noņemt nošu līniju no visiem grupējumiem"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/GrandStaffStart.xml.h:1
msgid "GrandStaff Start"
msgstr "GrandStaff sākums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/GrandStaffStart.xml.h:2
msgid "Start grouping single staves together in order to form multi-stave systems. In a GrandStaff, the group begins with a brace, and bar lines are connected between the staves."
msgstr "Sākt grupēt atsevišķas nošu līnijas, lai veidotu vairāku nošu līniju sistēmas. GrandStaff grupa sākas ar figūriekavu, un taktsvītras starp nošu līnijām tiek savienotas."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/GroupStaffStart.xml.h:1
msgid "GroupStaff Start"
msgstr "GroupStaff sākums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/GroupStaffStart.xml.h:2
msgid "Start grouping single staves together in order to form multi-stave systems. In the GroupStaff context, the group is started with a bracket and bar lines are drawn through all the staves."
msgstr "Sākt grupēt atsevišķas nošu līnijas, lai veidotu vairāku nošu līniju sistēmas. GroupStaff kontekstā grupa sākas ar kvadrātiekavu, un taktsvītras tiek novilktas cauri visām nošu līnijām."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/PianoStaffStart.xml.h:1
msgid "PianoStaff Start"
msgstr "PianoStaff sākums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffGroupings/PianoStaffStart.xml.h:2
msgid "Start grouping single staves together in order to form multi-stave systems. The PianoStaff is identical to a GrandStaff, except that it supports printing the instrument name directly."
msgstr "Sākt grupēt atsevišķas nošu līnijas, lai veidotu vairāku nošu līniju sistēmas. PianoStaff ir identisks GrandStaff, izņemot to, ka tas atbalsta instrumenta nosaukuma tiešu drukāšanu."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffMultiMeasureRests.xml.h:2
msgid "Groups of whole measure rests of two or more are changed to multi-measure rests for the whole staff."
msgstr "Divu vai vairāku visas takts pauzu grupas visai nošu līnijai tiek pārveidotas par vairāku taktu pauzēm."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Ambitus.xml.h:1
msgid "(Print) Ambitus On/Off"
msgstr "(Druka) Ambits iesl./izsl."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Ambitus.xml.h:2
msgid "Toggle the ambitus engraver for this staff on or off"
msgstr "Ieslēgt vai izslēgt šīs nošu līnijas ambita gravētāju"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/AssignInstrument.scm:7
msgid "Copy and Paste the music from the old staffs to the new, and then delete the old staffs"
msgstr "Kopēt un ielīmēt mūziku no vecajām nošu līnijām jaunajās un pēc tam dzēst vecās nošu līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/AssignInstrument.scm:16
msgid "Copy and Paste the music from the old staff to the new, and then delete the old staff"
msgstr "Kopēt un ielīmēt mūziku no vecās nošu līnijas jaunajā un pēc tam dzēst veco nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/AssignInstrument.xml.h:1
msgid "Assign Instrument"
msgstr "Piešķirt instrumentu"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/AssignInstrument.xml.h:2
msgid "Assigns the current staff to an instrument selected by the user."
msgstr "Piešķir pašreizējo nošu līniju lietotāja izvēlētam instrumentam."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:23
msgid "Chord Chart"
msgstr "Akordu tabula"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:56
msgid "Double"
msgstr "Dubultā"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:57
msgid "RepeatStart"
msgstr "RepeatStart"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:58
msgid "RepeatEnd"
msgstr "RepeatEnd"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:59
msgid "RepeatEndFirstTime"
msgstr "RepeatEndFirstTime"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:117
msgid "Compact Chord Chart Marker"
msgstr "Kompaktās akordu tabulas marķieris"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:126
msgid "Compact Chord Chart"
msgstr "Kompaktā akordu tabula"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:126
msgid "Paper Chord Chart"
msgstr "Papīra akordu tabula"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:126
msgid "Convert Staff"
msgstr "Pārveidot nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.scm:126
msgid "Customizable Chord Chart"
msgstr "Pielāgojama akordu tabula"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.xml.h:1
msgid "Chord Chart Staff"
msgstr "Akordu tabulas nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordChartStaff.xml.h:2
msgid "Prints Chord symbols separated by bar lines. Repeats, time signatures and text are also printed for this staff."
msgstr "Drukā akordu simbolus, atdalītus ar taktsvītrām. Šai nošu līnijai tiek drukāti arī atkārtojumi, taktsmēri un teksts."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordStaff.xml.h:1
msgid "Chord Symbols (Off/On)"
msgstr "Akordu simboli (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ChordStaff.xml.h:2
msgid "Typesets the music on this staff as chord symbols (off/on)."
msgstr "Saliek šīs nošu līnijas mūziku kā akordu simbolus (izsl./iesl.)."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.scm:5
msgid "Guitar"
msgstr "Ģitāra"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.scm:6
msgid "Mandolin"
msgstr "Mandolīna"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.scm:7
msgid "Ukulele"
msgstr "Ukulele"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.scm:16
msgid "This score cannot be typeset until you have entered some chords in this staff (which will then be typeset as fret diagrams)"
msgstr "Šo partitūru nevar salikt, kamēr šajā nošu līnijā nav ievadīti akordi (kas pēc tam tiks salikti kā grifa diagrammas)"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.xml.h:1
msgid "Fret Diagrams (Off/On)"
msgstr "Grifa diagrammas (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/FretDiagrams/FretBoards.xml.h:2
msgid "Chords on this staff will typeset as fret diagrams (off/on). Choose from several instruments."
msgstr "Akordi šajā nošu līnijā tiks salikti kā grifa diagrammas (izsl./iesl.). Izvēlieties no vairākiem instrumentiem."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.scm:8
msgid "Instrument Name should not be set on a Dynamics Line or Chord Symbols"
msgstr "Instrumenta nosaukumu nevajadzētu iestatīt dinamikas līnijā vai akordu simboliem"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.scm:24
msgid "InstrumentName"
msgstr "InstrumentName"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.scm:24
msgid ""
"Give name of instrument/voice/part\n"
"for current staff:"
msgstr ""
"Ievadiet pašreizējās nošu līnijas\n"
"instrumenta/balss/partijas nosaukumu:"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.scm:44
#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.xml.h:1
#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/PianoStaffName.scm:5
msgid "Instrument Name"
msgstr "Instrumenta nosaukums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.scm:44
msgid ""
"This sets the name in Movement 1\n"
"Set this name for the same staff in other movements?"
msgstr ""
"Tas iestata nosaukumu 1. daļā\n"
"Iestatīt šo nosaukumu tai pašai nošu līnijai arī citās daļās?"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/InstrumentName.xml.h:2
msgid "Print Instrument name before staff at start of score,"
msgstr "Drukāt instrumenta nosaukumu pirms nošu līnijas partitūras sākumā,"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/MidiInstrumentName.scm:11
msgid "MIDI Instrument Name"
msgstr "MIDI instrumenta nosaukums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/MidiInstrumentName.scm:11
msgid "Give name of MIDI instrument for current staff:"
msgstr "Ievadiet pašreizējās nošu līnijas MIDI instrumenta nosaukumu:"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/MidiInstrumentName.xml.h:1
msgid "MIDI Instrument"
msgstr "MIDI instruments"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/MidiInstrumentName.xml.h:2
msgid "Sets the MIDI instrument for this staff for use in the Playback View"
msgstr "Iestata šīs nošu līnijas MIDI instrumentu izmantošanai atskaņošanas skatā"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/NonPrintingStaff.scm:12
msgid "Staff will be printed"
msgstr "Nošu līnija tiks drukāta"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/NonPrintingStaff.xml.h:1
msgid "Non Printing Staff"
msgstr "Nedrukājama nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/NonPrintingStaff.xml.h:2
msgid "Turns the on/off whether this staff will be typeset. The staff still displays normally but will be dropped for the print view."
msgstr "Ieslēdz/izslēdz, vai šī nošu līnija tiks salikta. Nošu līnija joprojām tiek attēlota parasti, bet drukas skatā tiks izlaista."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/PianoStaffName.scm:5
msgid "Give name of instrument for staff group starting here:"
msgstr "Ievadiet šeit sākošās nošu līniju grupas instrumenta nosaukumu:"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/PianoStaffName.xml.h:1
msgid "Piano Staff Name"
msgstr "Klavieru nošu līnijas nosaukums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/PianoStaffName.xml.h:2
msgid "Prints the name given at the start of the Piano staff which must be where the cursor is. Remove instrument names on the individual staffs by setting them blank."
msgstr "Izdrukā norādīto nosaukumu klavieru nošu līnijas sākumā, kurā jāatrodas kursoram. Atsevišķo nošu līniju instrumentu nosaukumus noņemiet, iestatot tos tukšus."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/RhythmicStaff.xml.h:1
msgid "Rhythmic Staff"
msgstr "Ritmiskā nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/RhythmicStaff.xml.h:2
msgid "The staff will display as rhythm only, with pitches being ignored."
msgstr "Nošu līnija tiks attēlota tikai kā ritms, skaņu augstumus ignorējot."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffLines.scm:3
msgid "Staff Lines"
msgstr "Nošu līnijas līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffLines.scm:3
msgid "Give Number of Staff Lines for current staff"
msgstr "Ievadiet pašreizējās nošu līnijas līniju skaitu"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffLines.xml.h:1
msgid "Set Staff Lines"
msgstr "Iestatīt nošu līnijas līnijas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffLines.xml.h:2
msgid "Sets the number of lines for the current staff."
msgstr "Iestata pašreizējās nošu līnijas līniju skaitu."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffRangeFromChord.scm:4
msgid "The cursor must be on a chord with the highest note and lowest note set to the range desired."
msgstr "Kursoram jāatrodas uz akorda, kura augstākā un zemākā nots iestatīta vēlamajā diapazonā."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffRangeFromChord.xml.h:1
msgid "Set Staff Range"
msgstr "Iestatīt nošu līnijas diapazonu"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SetStaffRangeFromChord.xml.h:2
msgid "Sets the highest and lowest notes valid for the current staff to the highest and lowest pitches of the chord at the cursor. Notes outside that range will be typeset but will display as red notes to warn you that you are outside the range of the current instrument."
msgstr "Iestata pašreizējai nošu līnijai derīgās augstākās un zemākās notis atbilstoši akorda pie kursora augstākajam un zemākajam skaņas augstumam. Notis ārpus šī diapazona tiks saliktas, bet attēlotas sarkanā krāsā, lai brīdinātu, ka esat ārpus pašreizējā instrumenta diapazona."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ShortInstrumentName.scm:5
msgid "Instrument Name should not be set on a Dynamics Line"
msgstr "Instrumenta nosaukumu nevajadzētu iestatīt dinamikas līnijā"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ShortInstrumentName.scm:16
#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ShortInstrumentName.xml.h:1
msgid "Short Instrument Name"
msgstr "Īsais instrumenta nosaukums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ShortInstrumentName.scm:16
msgid "Give Short Instrument Name:"
msgstr "Ievadiet īso instrumenta nosaukumu:"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/ShortInstrumentName.xml.h:2
msgid "Prints shortened form of instrument name before this staff for second and subsequent systems"
msgstr "Izdrukā instrumenta nosaukuma saīsināto formu pirms šīs nošu līnijas otrajā un nākamajās sistēmās"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SmallerStaff.xml.h:1
msgid "Smaller Staff"
msgstr "Mazāka nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SmallerStaff.xml.h:2
msgid "The current staff will print in a smaller size. Use this for the solo part above a piano accompaniment"
msgstr "Pašreizējā nošu līnija tiks drukāta mazākā izmērā. Izmantojiet to solo partijai virs klavieru pavadījuma"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffComment.scm:4
msgid "comment for this staff"
msgstr "šīs nošu līnijas komentārs"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffComment.scm:5
msgid "Staff Comment"
msgstr "Nošu līnijas komentārs"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffComment.scm:5
msgid "Give comment text for current staff "
msgstr "Ievadiet pašreizējās nošu līnijas komentāra tekstu "

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffComment.xml.h:2
msgid "Saves textual comments for this staff"
msgstr "Saglabā šīs nošu līnijas teksta komentārus"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffOctaveUp.xml.h:1
msgid "(Print) Octave Up"
msgstr "(Druka) Oktāvu augstāk"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffOctaveUp.xml.h:2
msgid "Prints out the music of this staff one octave higher."
msgstr "Izdrukā šīs nošu līnijas mūziku oktāvu augstāk."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffSize.scm:4
msgid "Setting Staff Size"
msgstr "Nošu līnijas izmēra iestatīšana"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffSize.scm:4
msgid "Give Staff Size (for printing), 0 for default"
msgstr "Ievadiet nošu līnijas izmēru (drukāšanai), 0 — noklusējums"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffSize.xml.h:1
msgid "Set Staff Size"
msgstr "Iestatīt nošu līnijas izmēru"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/StaffSize.xml.h:2
msgid "Sets the size of the staff on printing relative to the default 0. Value -3 is tiny 3 is large."
msgstr "Iestata nošu līnijas izmēru drukājot attiecībā pret noklusējuma 0. Vērtība -3 ir ļoti maza, 3 — liela."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SubstituteMusic.scm:37
msgid "There are no other staffs for this one to mirror."
msgstr "Nav citu nošu līniju, ko šī varētu spoguļot."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SubstituteMusic.scm:60
msgid "Right click to update clef/time/key"
msgstr "Ar labo klikšķi atjauniniet atslēgu/taktsmēru/toņkārtu"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SubstituteMusic.scm:65
msgid "Music here is mirrored from "
msgstr "Mūzika šeit ir spoguļota no "

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SubstituteMusic.xml.h:1
msgid "Substitute Music (Borrowed/Mirrored)"
msgstr "Aizstāt mūziku (aizgūta/spoguļota)"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/SubstituteMusic.xml.h:2
msgid "Typesets this staff with the music from another staff, ignoring any music entered on this staff. Use this e.g. to create a staff with two divisi parts, while keeping the second part as a separate staff, or to typeset both Fret Diagrams and Chord Symbols from the same music. Note that initial clef/key/time are copied not mirrored. Staff number to mirror is chosen interactively or passed as a parameter to the command."
msgstr "Saliek šo nošu līniju ar mūziku no citas nošu līnijas, ignorējot šajā nošu līnijā ievadīto mūziku. Izmantojiet to, piem., lai izveidotu nošu līniju ar divām divisi partijām, saglabājot otro partiju kā atsevišķu nošu līniju, vai lai no vienas mūzikas saliktu gan grifa diagrammas, gan akordu simbolus. Ņemiet vērā, ka sākotnējā atslēga/toņkārta/taktsmērs tiek kopēti, nevis spoguļoti. Spoguļojamās nošu līnijas numurs tiek izvēlēts interaktīvi vai nodots komandai kā parametrs."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Tablature/SetTabStrings.xml.h:1
msgid "Set Open Strings"
msgstr "Iestatīt vaļējās stīgas"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Tablature/SetTabStrings.xml.h:2
msgid "Sets the open strings for tablature to the notes of the current chord."
msgstr "Iestata tabulatūras vaļējās stīgas atbilstoši pašreizējā akorda notīm."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Tablature/TabStaff.xml.h:1
msgid "Tablature"
msgstr "Tabulatūra"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/Tablature/TabStaff.xml.h:2
msgid "Converts to tablature notation (print only)"
msgstr "Pārveido tabulatūras notācijā (tikai drukai)"

#. TinyStaff
#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TinyStaff.xml.h:1
msgid "Tiny Staff"
msgstr "Ļoti maza nošu līnija"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TinyStaff.xml.h:2
msgid "Prints current staff in a tiny font."
msgstr "Izdrukā pašreizējo nošu līniju ļoti mazā fontā."

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TransposeStaffPrint.scm:8
msgid "--> Transpose to -->"
msgstr "--> Transponēt uz -->"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TransposeStaffPrint.scm:12
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/TransposeVoices.scm:10
msgid "Print transposed:  "
msgstr "Drukāt transponētu:  "

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TransposeStaffPrint.xml.h:1
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/TransposeVoices.xml.h:1
msgid "(Print) Transpose"
msgstr "(Druka) Transponēt"

#: ../actions/menus/ObjectMenu/StaffMenu/StaffPropertiesMenu/TransposeStaffPrint.xml.h:2
msgid "Prints this staff (only) transposed. This is in addition to any score-wide transposition"
msgstr "Izdrukā (tikai) šo nošu līniju transponētu. Tas ir papildus jebkurai visas partitūras transpozīcijai"

#: ../actions/menus/ObjectMenu/StaffMenu/UndotRests.xml.h:1
msgid "Un-dot Rests"
msgstr "Noņemt pauzēm punktus"

#: ../actions/menus/ObjectMenu/StaffMenu/UndotRests.xml.h:2
msgid "Changes dotted rests into the equivalent sequence of un-dotted rests in the current staff. Use e.g. in 6/8 time to replace 𝅘𝅥. with 𝄽 𝄾"
msgstr "Maina punktētas pauzes pašreizējā nošu līnijā par līdzvērtīgu nepunktētu pauzu secību. Izmantojiet, piem., 6/8 taktsmērā, lai 𝅘𝅥. aizstātu ar 𝄽 𝄾"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/AddMirrorVoice.xml.h:1
msgid "Add Voice (Borrowed/Mirrored Music)"
msgstr "Pievienot balsi (aizgūta/spoguļota mūzika)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/AddMirrorVoice.xml.h:2
msgid "Adds a voice whose music is automatically mirrored from another staff of your choice. Use this e.g. to create a staff with two divisi parts, while keeping the second part as a separate staff, or to typeset both Fret Diagrams and Chord Symbols from the same music. Note that initial clef/key/time are copied not mirrored."
msgstr "Pievieno balsi, kuras mūzika tiek automātiski spoguļota no citas jūsu izvēlētas nošu līnijas. Izmantojiet to, piem., lai izveidotu nošu līniju ar divām divisi partijām, saglabājot otro partiju kā atsevišķu nošu līniju, vai lai no vienas mūzikas saliktu gan grifa diagrammas, gan akordu simbolus. Ņemiet vērā, ka sākotnējā atslēga/toņkārta/taktsmērs tiek kopēti, nevis spoguļoti."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/CreatePartsFromTop.xml.h:1
msgid "Create Parts (Treble First)"
msgstr "Izveidot partijas (augšējā vispirms)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/CreatePartsFromTop.xml.h:2
msgid "Creates a set of parts extracting the highest part first."
msgstr "Izveido partiju kopu, vispirms izvelkot augstāko partiju."

#. CreateParts
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/CreateParts.scm:2
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/CreateParts.xml.h:1
msgid "Create Parts"
msgstr "Izveidot partijas"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/CreateParts.xml.h:2
msgid "Create a number of parts from the current staff which should have chords with that number of notes per chord."
msgstr "Izveidot vairākas partijas no pašreizējās nošu līnijas, kurā jābūt akordiem ar tādu pašu nošu skaitu akordā."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceAuto.xml.h:1
msgid "Initial Automatic Voice"
msgstr "Sākotnējā automātiskā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceAuto.xml.h:2
msgid "Undoes the effect of the InitialVoiceOne, Two ... commands. The voice has variable stem direction, slur placement etc."
msgstr "Atceļ komandu InitialVoiceOne, Two ... efektu. Balsij ir mainīgs kātiņu virziens, legato līgu novietojums u. c."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceFour.scm:4
msgid "Voice Four"
msgstr "Ceturtā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceFour.xml.h:1
msgid "Initial Voice Four"
msgstr "Sākotnējā ceturtā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceFour.xml.h:2
msgid "Sets the (initial) voice of the staff to be voice four (this affects stems down, slurs etc on printing)"
msgstr "Iestata nošu līnijas (sākotnējo) balsi kā ceturto balsi (tas ietekmē kātiņus uz leju, legato līgas u. c. drukājot)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceOne.scm:4
msgid "Voice One"
msgstr "Pirmā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceOne.xml.h:1
msgid "Initial Voice One"
msgstr "Sākotnējā pirmā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceOne.xml.h:2
msgid "Sets the (initial) voice of the staff to be voice one (this affects stems up, slurs etc on printing)"
msgstr "Iestata nošu līnijas (sākotnējo) balsi kā pirmo balsi (tas ietekmē kātiņus uz augšu, legato līgas u. c. drukājot)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceThree.scm:4
msgid "Voice Three"
msgstr "Trešā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceThree.xml.h:1
msgid "Initial Voice Three"
msgstr "Sākotnējā trešā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceThree.xml.h:2
msgid "Sets the (initial) voice of the staff to be voice three (this affects stems up, slurs etc on printing)"
msgstr "Iestata nošu līnijas (sākotnējo) balsi kā trešo balsi (tas ietekmē kātiņus uz augšu, legato līgas u. c. drukājot)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceTwo.scm:4
msgid "Voice Two"
msgstr "Otrā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceTwo.xml.h:1
msgid "Initial Voice Two"
msgstr "Sākotnējā otrā balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoiceTwo.xml.h:2
msgid "Sets the (initial) voice of the staff to be voice two (this affects stems down, slurs etc on printing)"
msgstr "Iestata nošu līnijas (sākotnējo) balsi kā otro balsi (tas ietekmē kātiņus uz leju, legato līgas u. c. drukājot)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoice.xml.h:1
msgid "Choose Initial Voice"
msgstr "Izvēlēties sākotnējo balsi"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/InitialVoice.xml.h:2
msgid "Choose which voice this staff will initially be set to. To change voice during music see the Directives-&gt;Voices menu."
msgstr "Izvēlieties, kurā balsī šī nošu līnija sākotnēji tiks iestatīta. Lai mainītu balsi mūzikas gaitā, sk. izvēlni Direktīvas-&gt;Balsis."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeDifferentlyDottedOff.xml.h:1
msgid "Merge Differently Dotted Off"
msgstr "Atšķirīgi punktētu nošu apvienošana izslēgta"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeDifferentlyDottedOff.xml.h:2
#: ../actions/palettes.xml.h:111
msgid "From this point notes in different voices that begin at the same time will not be merged onto the same stem if they differ in the dotting."
msgstr "No šī punkta dažādu balsu notis, kas sākas vienlaikus, netiks apvienotas uz viena kātiņa, ja tās atšķiras punktējumā."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeDifferentlyDottedOn.xml.h:1
msgid "Differently Dotted Merge On"
msgstr "Atšķirīgi punktētu nošu apvienošana ieslēgta"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeDifferentlyDottedOn.xml.h:2
#: ../actions/palettes.xml.h:110
msgid "From this point in the music notes in different voices beginning at the same time will be merged onto the same stem even if they differ in the dotting."
msgstr "No šī mūzikas punkta dažādu balsu notis, kas sākas vienlaikus, tiks apvienotas uz viena kātiņa arī tad, ja tās atšķiras punktējumā."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeRests.scm:6
msgid "Turning off merging of rests, use Merge Rests command to turn it on"
msgstr "Izslēdz pauzu apvienošanu; lai to ieslēgtu, izmantojiet komandu „Apvienot pauzes”"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeRests.xml.h:1
msgid "Merge Rests"
msgstr "Apvienot pauzes"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/MergeRests.xml.h:2
msgid "Merges rests where two voices have a common rest. Applies to the whole movement. For multi-measure rests you need to additionally suppress one of the multi-measure rest counts."
msgstr "Apvieno pauzes, ja divām balsīm ir kopīga pauze. Attiecas uz visu daļu. Vairāku taktu pauzēm papildus jāapslāpē viens no vairāku taktu pauzes skaitiem."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NewVoice.xml.h:2
msgid "Adds a voice to the current staff, initially displayed on a staff of its own, for readability. It will print on the staff above, and can be displayed there using Join Voices command if desired."
msgstr "Pievieno pašreizējai nošu līnijai balsi, sākotnēji attēlotu atsevišķā nošu līnijā labākai lasāmībai. Tā tiks izdrukāta augšējā nošu līnijā, un, ja vēlaties, to tur var attēlot ar komandu „Apvienot balsis”."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NoteColumnShift.scm:5
msgid "Horizontal Shift"
msgstr "Horizontālā nobīde"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NoteColumnShift.scm:5
msgid "Give amount (staff spaces)"
msgstr "Ievadiet daudzumu (nošu līnijas atstarpēs)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NoteColumnShift.xml.h:1
msgid "Change Note Shift"
msgstr "Mainīt nots nobīdi"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NoteColumnShift.xml.h:2
msgid "On printing the current note/chord will be shifted from notes in other voices by the amount you give. Use this to alter which voice is shifted leftwards/rightwards."
msgstr "Drukājot pašreizējā nots/akords tiks nobīdīts no citu balsu notīm par jūsu norādīto daudzumu. Izmantojiet to, lai mainītu, kura balss tiek nobīdīta pa kreisi/pa labi."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/IgnoreClashingNoteColumns.scm:6
msgid "Clashing Note Columns will generate a warning from the LilyPond typesetter"
msgstr "Sadurošās nošu kolonnas izraisīs LilyPond salikšanas programmas brīdinājumu"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/IgnoreClashingNoteColumns.scm:10
msgid "Ignore Clashing Columns"
msgstr "Ignorēt sadurošās kolonnas"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/IgnoreClashingNoteColumns.xml.h:1
msgid "Clashing Note Column Warnings (Off/On)"
msgstr "Brīdinājumi par sadurošām nošu kolonnām (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/IgnoreClashingNoteColumns.xml.h:2
msgid "Turns warnings from the LilyPond typesetter about clashing note columns off or on. These can be harmless but can cause a warning to check the score."
msgstr "Ieslēdz vai izslēdz LilyPond salikšanas programmas brīdinājumus par sadurošām nošu kolonnām. Tie var būt nekaitīgi, bet var izraisīt brīdinājumu partitūras pārbaudē."

#. partcombineApart
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineApart.scm:2
msgid ""
"This directive instructs the LilyPond typesetter not to combine notes from the voices when part combining has been set..\n"
"Use with the Part Combine command.\n"
"You can delete the directive as any other object."
msgstr ""
"Šī direktīva liek LilyPond salikšanas programmai neapvienot balsu notis, ja iestatīta partiju apvienošana..\n"
"Izmantojiet kopā ar komandu „Partiju apvienošana”.\n"
"Direktīvu var izdzēst kā jebkuru citu objektu."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineApart.xml.h:1
msgid "Keep Voices Apart"
msgstr "Turēt balsis atsevišķi"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineApart.xml.h:2
#: ../actions/palettes.xml.h:115
msgid "When part combining, from this point the parts will be kept apart even though they could be combined."
msgstr "Partiju apvienošanā no šī punkta partijas tiks turētas atsevišķi, lai gan tās varētu apvienot."

#. partcombineAutomatic
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineAutomatic.scm:2
msgid ""
"This directive instructs the LilyPond typesetter to combine notes from the voices using the default part combining.\n"
"Use with the Part Combine command.\n"
"You can delete the directive as any other object."
msgstr ""
"Šī direktīva liek LilyPond salikšanas programmai apvienot balsu notis, izmantojot noklusējuma partiju apvienošanu.\n"
"Izmantojiet kopā ar komandu „Partiju apvienošana”.\n"
"Direktīvu var izdzēst kā jebkuru citu objektu."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineAutomatic.xml.h:1
msgid "Automatic"
msgstr "Automātisks"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineAutomatic.xml.h:2
#: ../actions/palettes.xml.h:114
msgid "Reverts to the default part combining."
msgstr "Atgriežas pie noklusējuma partiju apvienošanas."

#. partcombineChords
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineChords.scm:2
msgid ""
"This directive instructs the LilyPond typesetter to combine notes from the voices into chords.\n"
"Use with the Part Combine command.\n"
"You can delete the directive as any other object."
msgstr ""
"Šī direktīva liek LilyPond salikšanas programmai apvienot balsu notis akordos.\n"
"Izmantojiet kopā ar komandu „Partiju apvienošana”.\n"
"Direktīvu var izdzēst kā jebkuru citu objektu."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineChords.xml.h:1
msgid "Part Combine Chords"
msgstr "Partiju apvienošana akordos"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineChords.xml.h:2
#: ../actions/palettes.xml.h:112
msgid "From the cursor onwards chords will be combined from the parts included in the part combine command."
msgstr "No kursora tālāk akordi tiks apvienoti no partiju apvienošanas komandā iekļautajām partijām."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:9
msgid "Parts are now uncombined"
msgstr "Partijas tagad ir atvienotas"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:14
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:21
msgid "Part Combine "
msgstr "Partiju apvienošana "

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:30
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:36
msgid "Can only part-combine two voices"
msgstr "Var apvienot tikai divas balsis"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.scm:38
msgid "Must be on a staff with two voices"
msgstr "Jāatrodas nošu līnijā ar divām balsīm"

#. partcombineUnisono
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineUnisono.scm:2
msgid ""
"This directive instructs the LilyPond typesetter to combine notes from the voices as unison.\n"
"Use with the Part Combine command.\n"
"You can delete the directive as any other object."
msgstr ""
"Šī direktīva liek LilyPond salikšanas programmai apvienot balsu notis kā unisonu.\n"
"Izmantojiet kopā ar komandu „Partiju apvienošana”.\n"
"Direktīvu var izdzēst kā jebkuru citu objektu."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineUnisono.xml.h:1
msgid "Unisono"
msgstr "Unisono"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombineUnisono.xml.h:2
#: ../actions/palettes.xml.h:113
msgid "Combine parts as unison."
msgstr "Apvienot partijas kā unisonu."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.xml.h:1
msgid "Part Combine Two Voices"
msgstr "Apvienot divu balsu partijas"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/Part-Combining/PartCombine.xml.h:2
msgid "The two voices will be printed only once when they are the same, otherwise they will be printed as parts. (Off/On)"
msgstr "Abas balsis tiks izdrukātas tikai vienreiz, ja tās ir vienādas, citādi tās tiks izdrukātas kā partijas. (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentStaffAsVoice.scm:4
msgid "Current staff is already a voice or not suitable"
msgstr "Pašreizējā nošu līnija jau ir balss vai nav piemērota"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentStaffAsVoice.xml.h:1
msgid "Staff to Voice"
msgstr "Nošu līnija uz balsi"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentStaffAsVoice.xml.h:2
msgid "The current staff will be typeset as a voice on the staff above."
msgstr "Pašreizējā nošu līnija tiks salikta kā balss augšējā nošu līnijā."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentVoiceAsStaff.scm:4
msgid "The current staff is not voice"
msgstr "Pašreizējā nošu līnija nav balss"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentVoiceAsStaff.xml.h:1
msgid "Voice to Staff"
msgstr "Balss uz nošu līniju"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/SetCurrentVoiceAsStaff.xml.h:2
msgid "The current voice will be typeset on its own staff."
msgstr "Pašreizējā balss tiks salikta savā nošu līnijā."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOff.scm:6
msgid "No Shift"
msgstr "Bez nobīdes"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOff.xml.h:1
msgid "No Horizontal Shifts"
msgstr "Bez horizontālām nobīdēm"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOff.xml.h:2
#: ../actions/palettes.xml.h:106
msgid "Turns off horizontal displacement of notes (which avoid collisions between parts)"
msgstr "Izslēdz nošu horizontālo nobīdi (kas novērš sadursmes starp partijām)"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOn.scm:6
msgid "Shift"
msgstr "Nobīde"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOn.xml.h:1
msgid "Use Horizontal Shifts"
msgstr "Izmantot horizontālās nobīdes"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/ShiftOn.xml.h:2
#: ../actions/palettes.xml.h:107
msgid "Turns on horizontal displacements of notes where needed."
msgstr "Ieslēdz nošu horizontālās nobīdes, kur vajadzīgs."

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/TransposeVoices.scm:6
msgid "<-- Transpose to -->"
msgstr "<-- Transponēt uz -->"

#: ../actions/menus/ObjectMenu/StaffMenu/Voices/TransposeVoices.xml.h:2
msgid "Prints the voices transposed by the interval given. This is in addition to any score-wide transposition and any staff-wide transposition"
msgstr "Izdrukā balsis, transponētas par norādīto intervālu. Tas ir papildus jebkurai visas partitūras un visas nošu līnijas transpozīcijai"

#: ../actions/menus/ObjectMenu/TimeSig/ApparentTimeSignature.xml.h:1
msgid "Apparent Time Signature"
msgstr "Šķietamais taktsmērs"

#: ../actions/menus/ObjectMenu/TimeSig/ApparentTimeSignature.xml.h:2
msgid "Typesets a time signature which is not the one actually being used. This is used in polymetric music, often in conjunction with a tuplet spanning the whole staff."
msgstr "Saliek taktsmēru, kas nav faktiski izmantotais. To izmanto polimetriskā mūzikā, bieži kopā ar tupletu, kas aptver visu nošu līniju."

#: ../actions/menus/ObjectMenu/TimeSig/BeamHalfMeasure.scm:5
msgid "Beaming at half measure allowed"
msgstr "Svītrošana pustaktī atļauta"

#: ../actions/menus/ObjectMenu/TimeSig/BeamHalfMeasure.scm:8
msgid "Beaming breaks at half-measure"
msgstr "Svītrošana pārtraucas pustaktī"

#: ../actions/menus/ObjectMenu/TimeSig/BeamHalfMeasure.xml.h:1
msgid "Beam at Half Measure (Off/On)"
msgstr "Svītrot pustaktī (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/TimeSig/BeamHalfMeasure.xml.h:2
msgid "In time signatures 3/N prevent beaming across the beat. Repeat the command to allow such beaming."
msgstr "Taktsmēros 3/N novērst svītrošanu pāri sitienam. Lai šādu svītrošanu atļautu, atkārtojiet komandu."

#: ../actions/menus/ObjectMenu/TimeSig/CadenzaTime.scm:6
#: ../actions/menus/ObjectMenu/TimeSig/CadenzaTime.xml.h:2
msgid "Inserts a non-printing timesignature to indicate a cadenza follows. You must insert any barlines and beaming you require (otherwise none will typeset). End the cadenza by inserting an End Cadenza Time in a new Denemo bar."
msgstr "Ievieto nedrukājamu taktsmēru, kas norāda, ka seko kadence. Jāievieto visas vajadzīgās taktsvītras un svītrojums (citādi nekas netiks salikts). Beidziet kadenci, jaunā Denemo taktī ievietojot „Kadences laika beigas”."

#: ../actions/menus/ObjectMenu/TimeSig/CadenzaTime.scm:14
msgid "Cadenza"
msgstr "Kadence"

#: ../actions/menus/ObjectMenu/TimeSig/CadenzaTime.xml.h:1
msgid "Start Cadenza Time"
msgstr "Sākt kadences laiku"

#: ../actions/menus/ObjectMenu/TimeSig/ChooseTimeSignature.xml.h:1
msgid "Choose Typical Time Signature"
msgstr "Izvēlēties tipisku taktsmēru"

#: ../actions/menus/ObjectMenu/TimeSig/ChooseTimeSignature.xml.h:2
msgid "Choose from a set of typical time signatures"
msgstr "Izvēlēties no tipisku taktsmēru kopas"

#: ../actions/menus/ObjectMenu/TimeSig/ChordChartTimeSignature.xml.h:1
msgid "Chord Chart Time Signature"
msgstr "Akordu tabulas taktsmērs"

#: ../actions/menus/ObjectMenu/TimeSig/ChordChartTimeSignature.xml.h:2
msgid "Inserts a time signature (for use in Chord Charts)"
msgstr "Ievieto taktsmēru (izmantošanai akordu tabulās)"

#: ../actions/menus/ObjectMenu/TimeSig/EndCadenzaTime.scm:10
msgid "End Cad."
msgstr "Kad. beigas"

#: ../actions/menus/ObjectMenu/TimeSig/EndCadenzaTime.scm:13
msgid "Inserts a time signature to resume normal measured music."
msgstr "Ievieto taktsmēru, lai atsāktu parastu taktētu mūziku."

#: ../actions/menus/ObjectMenu/TimeSig/EndCadenzaTime.xml.h:1
msgid "End Cadenza Time"
msgstr "Kadences laika beigas"

#: ../actions/menus/ObjectMenu/TimeSig/EndCadenzaTime.xml.h:2
msgid "Inserts a non-printing time signature to resume normal measured music."
msgstr "Ievieto nedrukājamu taktsmēru, lai atsāktu parastu taktētu mūziku."

#: ../actions/menus/ObjectMenu/TimeSig/HideTimesig.xml.h:2
msgid "On printing, omit the time signature change at the cursor, or the initial time signature if the cursor is not on a time signature change."
msgstr "Drukājot izlaist taktsmēra maiņu pie kursora vai sākotnējo taktsmēru, ja kursors nav uz taktsmēra maiņas."

#: ../actions/menus/ObjectMenu/TimeSig/InsertBeamingRule.scm:17
#: ../actions/menus/ObjectMenu/TimeSig/TimesigWithBeatStructure.scm:15
msgid "Beam"
msgstr "Svītra"

#: ../actions/menus/ObjectMenu/TimeSig/InsertBeamingRule.xml.h:1
msgid "Beaming Rule Change"
msgstr "Svītrošanas noteikuma maiņa"

#: ../actions/menus/ObjectMenu/TimeSig/InsertBeamingRule.xml.h:2
msgid "Inserts a (hidden) time signature with rules to be used for beaming. With no selection gets the beat for beams to be divided for the prevailing time signature at the cursor. If a there is a selection this will be used as the set of rules. In this case indicate the beaming desired using the manual beam commands [ and ], giving all the beaming rules wanted using several measures if needed (no other rules are used). Repeat with different selections to add further rules."
msgstr "Ievieto (paslēptu) taktsmēru ar svītrošanai izmantojamiem noteikumiem. Ja atlases nav, iegūst sitienu, pēc kura sadalīt svītras pašreizējam taktsmēram pie kursora. Ja ir atlase, tā tiks izmantota kā noteikumu kopa. Šādā gadījumā norādiet vēlamo svītrojumu ar manuālajām svītru komandām [ un ], ja nepieciešams, norādot visus vajadzīgos svītrošanas noteikumus vairākās taktīs (citi noteikumi netiek izmantoti). Lai pievienotu vēl noteikumus, atkārtojiet ar citām atlasēm."

#: ../actions/menus/ObjectMenu/TimeSig/NumericTimeSig.xml.h:1
msgid "Numeric Time Signature"
msgstr "Skaitlisks taktsmērs"

#: ../actions/menus/ObjectMenu/TimeSig/NumericTimeSig.xml.h:2
msgid "Typesets common and cut time numerically rather than the traditional C and C cut."
msgstr "Saliek parasto un alla breve taktsmēru skaitliski, nevis tradicionālo C un pārsvītroto C veidā."

#: ../actions/menus/ObjectMenu/TimeSig/SingleDigitTimeSig.scm:4
msgid "Inspect/Edit Single Digit Directive"
msgstr "Apskatīt/rediģēt viena cipara direktīvu"

#: ../actions/menus/ObjectMenu/TimeSig/SingleDigitTimeSig.xml.h:1
msgid "(Print) Single Digit"
msgstr "(Druka) Viens cipars"

#: ../actions/menus/ObjectMenu/TimeSig/SingleDigitTimeSig.xml.h:2
msgid "Makes the time signature at the cursor typeset as a single digit; if no time signature at cursor this applies to initial timesig of staff. Run the command again to delete/inspect the time signature directive."
msgstr "Liek taktsmēru pie kursora salikt kā vienu ciparu; ja pie kursora nav taktsmēra, tas attiecas uz nošu līnijas sākotnējo taktsmēru. Lai dzēstu/apskatītu taktsmēra direktīvu, palaidiet komandu vēlreiz."

#: ../actions/menus/ObjectMenu/TimeSig/TimesigWithBeatStructure.xml.h:1
msgid "Time Signature with Beaming Rule"
msgstr "Taktsmērs ar svītrošanas noteikumu"

#: ../actions/menus/ObjectMenu/TimeSig/TimesigWithBeatStructure.xml.h:2
msgid "Inserts a time signature with indication for how to beam the notes. Insert at beginning of staff in order to replace the initial time signature."
msgstr "Ievieto taktsmēru ar norādi, kā svītrot notis. Ievietojiet nošu līnijas sākumā, lai aizstātu sākotnējo taktsmēru."

#: ../actions/menus/ObjectMenu/TimeSig/TwoTimeSignatures.scm:9
msgid "Double time signature removed"
msgstr "Dubultais taktsmērs noņemts"

#: ../actions/menus/ObjectMenu/TimeSig/TwoTimeSignatures.xml.h:1
msgid "Two Time Signatures"
msgstr "Divi taktsmēri"

#: ../actions/menus/ObjectMenu/TimeSig/TwoTimeSignatures.xml.h:2
msgid "Prints two time-signatures, the second is active."
msgstr "Izdrukā divus taktsmērus, otrais ir aktīvais."

#: ../actions/menus/ObjectMenu/TimeSig/Unmeasured.xml.h:1
msgid "Unmeasured Staffs (Off/On)"
msgstr "Netaktētas nošu līnijas (izsl./iesl.)"

#: ../actions/menus/ObjectMenu/TimeSig/Unmeasured.xml.h:2
msgid "Makes the staffs accept any duration per Denemo measure and typesets as a cadenza. Equivalent to Cadenza Time from the first bar."
msgstr "Liek nošu līnijām pieņemt jebkādu ilgumu Denemo taktī un saliek kā kadenci. Līdzvērtīgi kadences laikam no pirmās takts."

#: ../actions/palettes.xml.h:2
msgid "Selects &#x1D15D; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D15D; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:3
msgid "Selects &#x1D15E; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D15E; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:4
msgid "Selects &#x1D15F; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D15F; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:5
msgid "Selects &#x1D160; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D160; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:6
msgid "Selects &#x1D161; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D161; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:7
msgid "Selects &#x1D163; as the duration for inserting notes or rests"
msgstr "Izvēlas &#x1D163; kā nošu vai pauzu ievietošanas ilgumu"

#: ../actions/palettes.xml.h:8
msgid "Alternates inserting start triplet and end triplet markers"
msgstr "Pārmaiņus ievieto triolas sākuma un triolas beigu marķierus"

#: ../actions/palettes.xml.h:9
msgid "General"
msgstr "Vispārīgas"

#: ../actions/palettes.xml.h:10
msgid "Choose any sort of clef.&#10;If the cursor is at the start change initial clef, else insert chosen clef."
msgstr "Izvēlēties jebkura veida atslēgu.&#10;Ja kursors ir sākumā, maina sākotnējo atslēgu, citādi ievieto izvēlēto atslēgu."

#: ../actions/palettes.xml.h:13
msgid "Add a note to the current chord&#10;The cursor position determines which note to add"
msgstr "Pievienot noti pašreizējam akordam&#10;Kursora pozīcija nosaka, kuru noti pievienot"

#: ../actions/palettes.xml.h:14
msgid "Begin Slur from note/chord at cursor, or remove a Begin Slur"
msgstr "Sākt legato līgu no nots/akorda pie kursora vai noņemt legato līgas sākumu"

#: ../actions/palettes.xml.h:15
msgid "End Slur at note/chord at cursor, or remove an End Slur"
msgstr "Beigt legato līgu pie nots/akorda pie kursora vai noņemt legato līgas beigas"

#: ../actions/palettes.xml.h:16
msgid "Tie/Untie from the note/chord at the cursor - will be ignored by the LilyPond typesetter if next note is not at the same pitch"
msgstr "Saistīt/atsaistīt ar līgu no nots/akorda pie kursora — LilyPond salikšanas programma to ignorēs, ja nākamā nots nav tādā pašā augstumā"

#: ../actions/palettes.xml.h:17
msgid "Insert a tempo change at cursor"
msgstr "Ievietot tempa maiņu pie kursora"

#: ../actions/palettes.xml.h:18
msgid "Insert a Dynamic Marking at the cursor"
msgstr "Ievietot dinamikas apzīmējumu pie kursora"

#: ../actions/palettes.xml.h:19
msgid "Start Crescendo from note/chord at cursor"
msgstr "Sākt crescendo no nots/akorda pie kursora"

#: ../actions/palettes.xml.h:20
msgid "End Crescendo on note/chord at cursor"
msgstr "Beigt crescendo uz nots/akorda pie kursora"

#: ../actions/palettes.xml.h:21
msgid "Start Diminuendo from note/chord at cursor "
msgstr "Sākt diminuendo no nots/akorda pie kursora "

#: ../actions/palettes.xml.h:22
msgid "End Diminuendo from note/chord at cursor"
msgstr "Beigt diminuendo uz nots/akorda pie kursora"

#: ../actions/palettes.xml.h:24
msgid "Choose more palettes of buttons."
msgstr "Izvēlēties vairāk pogu palešu."

#: ../actions/palettes.xml.h:26
msgid "Help with chord symbol entry methods."
msgstr "Palīdzība par akordu simbolu ievades metodēm."

#: ../actions/palettes.xml.h:27
msgid "Start Crescrendo from note/chord at cursor"
msgstr "Sākt crescendo no nots/akorda pie kursora"

#: ../actions/palettes.xml.h:28
msgid "Adds a staff to be used purely for dynamic markings, insert after right hand piano staff"
msgstr "Pievieno nošu līniju, ko izmantot tikai dinamikas apzīmējumiem; ievietojiet aiz klavieru labās rokas nošu līnijas"

#: ../actions/palettes.xml.h:29
msgid "Prints text to start or continue a crescendo extending over a passage.&#10;Use for cresc.&#10;poco a poco, for example.&#10;Terminate with End Crescendo marking or a dynamic mark, else nothing will be printed.&#10;LilyPond markup, such as \\\\bold can be used."
msgstr "Izdrukā tekstu, kas sāk vai turpina fragmentā stieptu crescendo.&#10;Izmantojiet, piemēram, cresc.&#10;poco a poco.&#10;Noslēdziet ar crescendo beigu apzīmējumu vai dinamikas zīmi, citādi nekas netiks izdrukāts.&#10;Var izmantot LilyPond marķējumu, piemēram, \\\\bold."

#: ../actions/palettes.xml.h:30
msgid "Prints text to start or continue a diminuendo extending over a passage.&#10;Use for dim.&#10;poco a poco, for example.&#10;Terminate with End Diminuendo marking or a dynamic mark, else nothing will be printed.&#10;LilyPond markup, such as \\\\bold can be used."
msgstr "Izdrukā tekstu, kas sāk vai turpina fragmentā stieptu diminuendo.&#10;Izmantojiet, piemēram, dim.&#10;poco a poco.&#10;Noslēdziet ar diminuendo beigu apzīmējumu vai dinamikas zīmi, citādi nekas netiks izdrukāts.&#10;Var izmantot LilyPond marķējumu, piemēram, \\\\bold."

#: ../actions/palettes.xml.h:31
msgid "Music is spaced out by the extra amount given to avoid textual dynamic markings colliding.&#10;Not for hairpins."
msgstr "Mūzika tiek izvietota ar norādīto papildu atstarpi, lai teksta dinamikas apzīmējumi nesadurtos.&#10;Nav paredzēts „dakšām”."

#: ../actions/palettes.xml.h:32
msgid "Pianoforte"
msgstr "Klavieres"

#: ../actions/palettes.xml.h:37
msgid "Inserts an 8va mark (transposing the notes accordingly) or terminates one already started."
msgstr "Ievieto 8va zīmi (attiecīgi transponējot notis) vai beidz jau sāktu."

#: ../actions/palettes.xml.h:38
msgid "Insert or Append Duration"
msgstr "Ievietot vai pievienot ilgumu"

#: ../actions/palettes.xml.h:39
msgid "When appending, appends a &#x1D15D; &#10;With the cursor on a note inserts a &#x1D15D;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D15D; &#10;Ja kursors ir uz nots, ievieto &#x1D15D;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:40
msgid "When appending, appends a &#x1D15E; &#10;With the cursor on a note inserts a &#x1D15E;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D15E; &#10;Ja kursors ir uz nots, ievieto &#x1D15E;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:41
msgid "When appending, appends a &#x1D15F; &#10;With the cursor on a note inserts a &#x1D15F;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D15F; &#10;Ja kursors ir uz nots, ievieto &#x1D15F;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:42
msgid "When appending, appends a &#x1D160; &#10;With the cursor on a note inserts a &#x1D160;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D160; &#10;Ja kursors ir uz nots, ievieto &#x1D160;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:43
msgid "When appending, appends a &#x1D161; &#10;With the cursor on a note inserts a &#x1D161;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D161; &#10;Ja kursors ir uz nots, ievieto &#x1D161;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:44
msgid "When appending, appends a &#x1D162; &#10;With the cursor on a note inserts a &#x1D162;  before the current note&#10;If MIDI-in is active, the note will be pitchless (displays yellow, percussion-sounding)&#10; - the MIDI keyboard will provide the pitch.&#10;Changes prevailing duration."
msgstr "Pievienošanas pozīcijā pievieno &#x1D162; &#10;Ja kursors ir uz nots, ievieto &#x1D162;  pirms pašreizējās nots&#10;Ja MIDI ievade ir aktīva, nots būs bez skaņas augstuma (attēlota dzeltena, skan kā sitamais)&#10; - skaņas augstumu nodrošinās MIDI klaviatūra.&#10;Maina pašreizējo ilgumu."

#: ../actions/palettes.xml.h:45
msgid "Insert &#x1D13B; rest"
msgstr "Ievietot &#x1D13B; pauzi"

#: ../actions/palettes.xml.h:46
msgid "Insert &#x1D13C; rest"
msgstr "Ievietot &#x1D13C; pauzi"

#: ../actions/palettes.xml.h:47
msgid "Insert &#x1D13D; rest"
msgstr "Ievietot &#x1D13D; pauzi"

#: ../actions/palettes.xml.h:48
msgid "Insert &#x1D13E; rest"
msgstr "Ievietot &#x1D13E; pauzi"

#: ../actions/palettes.xml.h:49
msgid "Insert &#x1D13F; rest"
msgstr "Ievietot &#x1D13F; pauzi"

#: ../actions/palettes.xml.h:50
msgid "Insert &#x1D140; rest"
msgstr "Ievietot &#x1D140; pauzi"

#: ../actions/palettes.xml.h:51
msgid "Dot, double dot or undot the note at the cursor"
msgstr "Punktēt, divreiz punktēt vai noņemt punktus notij pie kursora"

#: ../actions/palettes.xml.h:53
msgid "Change the current note to a &#x1D15D;"
msgstr "Mainīt pašreizējo noti uz &#x1D15D;"

#: ../actions/palettes.xml.h:54
msgid "Change the current note to a &#x1D15E;"
msgstr "Mainīt pašreizējo noti uz &#x1D15E;"

#: ../actions/palettes.xml.h:55
msgid "Change the current note to a &#x1D15F;"
msgstr "Mainīt pašreizējo noti uz &#x1D15F;"

#: ../actions/palettes.xml.h:56
msgid "Change the current note to a &#x1D160;"
msgstr "Mainīt pašreizējo noti uz &#x1D160;"

#: ../actions/palettes.xml.h:57
msgid "Change the current note to a &#x1D161;"
msgstr "Mainīt pašreizējo noti uz &#x1D161;"

#: ../actions/palettes.xml.h:58
msgid "Change the current note to a &#x1D162;"
msgstr "Mainīt pašreizējo noti uz &#x1D162;"

#: ../actions/palettes.xml.h:59
msgid "Halves the duration of the note/chord/rest at the cursor or the selection.&#10;E.g.&#10;Quarter Note becomes Eighth Note.&#10;"
msgstr "Uz pusi samazina nots/akorda/pauzes pie kursora vai atlases ilgumu.&#10;Piem.,&#10;ceturtdaļnots kļūst par astotdaļnoti.&#10;"

#: ../actions/palettes.xml.h:60
msgid "Doubles the duration of the note/chord/rest at the cursor or the selection.&#10;E.g.&#10;Quarter Note becomes Half Note."
msgstr "Divkāršo nots/akorda/pauzes pie kursora vai atlases ilgumu.&#10;Piem.,&#10;ceturtdaļnots kļūst par pusnoti."

#: ../actions/palettes.xml.h:61
msgid "Change or Append Notes"
msgstr "Mainīt vai pievienot notis"

#: ../actions/palettes.xml.h:62
msgid "Changes the note the cursor is on to the note A.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti A.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:63
msgid "Changes the note the cursor is on to the note B.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti H (B).&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:64
msgid "Changes the note the cursor is on to the note C.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti C.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:65
msgid "Changes the note the cursor is on to the note D.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti D.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:66
msgid "Changes the note the cursor is on to the note E.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti E.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:67
msgid "Changes the note the cursor is on to the note F.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti F.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:68
msgid "Changes the note the cursor is on to the note G.&#10;If the cursor is in the appending position, appends a note using the prevailing duration."
msgstr "Maina noti, uz kuras atrodas kursors, uz noti G.&#10;Ja kursors ir pievienošanas pozīcijā, pievieno noti ar pašreizējo ilgumu."

#: ../actions/palettes.xml.h:73
msgid "Sharpen the note at the cursor or next entered note if the cursor is in the appending position"
msgstr "Paaugstināt noti pie kursora vai nākamo ievadīto noti, ja kursors ir pievienošanas pozīcijā"

#: ../actions/palettes.xml.h:74
msgid "Flatten the note at the cursor or next entered note if the cursor is in the appending position"
msgstr "Pazemināt noti pie kursora vai nākamo ievadīto noti, ja kursors ir pievienošanas pozīcijā"

#: ../actions/palettes.xml.h:83
msgid "Stringed Instruments"
msgstr "Stīgu instrumenti"

#: ../actions/palettes.xml.h:98
msgid "The given number as right hand fingering, using the conventional p,m,i indicators.&#10;Use Cancel to delete"
msgstr "Norādītais skaitlis kā labās rokas pirksts, izmantojot ierastos apzīmējumus p, m, i.&#10;Lai dzēstu, izmantojiet Atcelt"

#: ../actions/palettes.xml.h:99
msgid "Asks for a finger number and typesets p,m,i as appropriate.&#10;Use cancel to delete."
msgstr "Prasa pirksta numuru un saliek attiecīgi p, m, i.&#10;Lai dzēstu, atceliet."

#: ../actions/palettes.xml.h:100
msgid "Places a diamond shape notehead at the cursor.&#10;Invoke this command with the cursor above the note to be fingered/fretted to notate an artificial harmonic."
msgstr "Novieto pie kursora rombveida nots galviņu.&#10;Izsauciet šo komandu ar kursoru virs nots, ko piespiež ar pirkstu, lai notētu mākslīgo flažoletu."

#: ../actions/palettes.xml.h:101
msgid "Polyphony"
msgstr "Polifonija"

#: ../actions/palettes.xml.h:102
msgid "Adds a voice to the current staff, initially displayed on a staff of its own, for readability.&#10;It will print on the staff above, and can be displayed there using Join Voices command if desired."
msgstr "Pievieno pašreizējai nošu līnijai balsi, sākotnēji attēlotu atsevišķā nošu līnijā labākai lasāmībai.&#10;Tā tiks izdrukāta augšējā nošu līnijā, un, ja vēlaties, to tur var attēlot ar komandu „Apvienot balsis”."

#: ../actions/palettes.xml.h:103
msgid "Select a voice for the music following the cursor position.&#10;The Voice 1,2,3,4 choices set up the voices so that first and third voices get stems up, second and fourth voices get stems down, third and fourth voice note heads are horizontally shifted, and rests in the respective voices are automatically moved to avoid collisions.&#10;The Automatic Voice setting returns all the voice settings to the neutral default directions"
msgstr "Izvēlieties balsi mūzikai aiz kursora pozīcijas.&#10;Izvēles „1., 2., 3., 4. balss” iestata balsis tā, ka pirmajai un trešajai balsij kātiņi ir uz augšu, otrajai un ceturtajai — uz leju, trešās un ceturtās balss nošu galviņas tiek horizontāli nobīdītas un attiecīgo balsu pauzes tiek automātiski pārvietotas, lai izvairītos no sadursmēm.&#10;Iestatījums „Automātiska balss” atgriež visus balsu iestatījumus uz neitrāliem noklusējuma virzieniem"

#: ../actions/palettes.xml.h:104
msgid "The two voices will be printed only once when they are the same, otherwise they will be printed as parts.&#10;(Off/On)"
msgstr "Abas balsis tiks izdrukātas tikai vienreiz, ja tās ir vienādas, citādi tās tiks izdrukātas kā partijas.&#10;(izsl./iesl.)"

#: ../actions/palettes.xml.h:105
msgid "(Print) Merges rests where two voices have a common rest.&#10;Not for whole measure or multi-measure rests."
msgstr "(Druka) Apvieno pauzes, ja divām balsīm ir kopīga pauze.&#10;Nav paredzēts visas takts vai vairāku taktu pauzēm."

#: ../actions/palettes.xml.h:108
msgid "On printing the current note/chord will be shifted from notes in other voices by the amount you give.&#10;Use with Voice Presets to ensure this chord is in a different voice."
msgstr "Drukājot pašreizējā nots/akords tiks nobīdīts no citu balsu notīm par jūsu norādīto daudzumu.&#10;Izmantojiet kopā ar balsu iestatījumiem, lai nodrošinātu, ka šis akords ir citā balsī."

#: ../actions/palettes.xml.h:109
msgid "Choose which voice this staff will initially be set to.&#10;To change voice during music see the Directives->Voices menu."
msgstr "Izvēlieties, kurā balsī šī nošu līnija sākotnēji tiks iestatīta.&#10;Lai mainītu balsi mūzikas gaitā, sk. izvēlni Direktīvas->Balsis."

#: ../actions/palettes.xml.h:116
msgid "Turns warnings from the LilyPond typesetter about clashing note columns off or on.&#10;These can be harmless but can cause a warning to check the score."
msgstr "Ieslēdz vai izslēdz LilyPond salikšanas programmas brīdinājumus par sadurošām nošu kolonnām.&#10;Tie var būt nekaitīgi, bet var izraisīt brīdinājumu partitūras pārbaudē."

#: ../actions/palettes.xml.h:122
msgid "Adds the > accent"
msgstr "Pievieno akcentu >"

#: ../actions/palettes.xml.h:124
msgid "The articulation(s) on this note will be placed outside the slur (furthest from the note).&#10;Repeat the command to return the slur to the outside."
msgstr "Šīs nots artikulācija(-s) tiks novietota(-s) ārpus legato līgas (vistālāk no nots).&#10;Lai atgrieztu legato līgu ārpusē, atkārtojiet komandu."

#: ../actions/palettes.xml.h:125
msgid "Barlines"
msgstr "Taktsvītras"

#: ../actions/palettes.xml.h:132
msgid "Choose a barline "
msgstr "Izvēlieties taktsvītru "

#: ../actions/palettes.xml.h:133
msgid "Create a custom barline.&#10;These can be named, or can simply override a standard LilyPond bar line type.&#10;A bar line is defined by four forms, which describe 1) the appearance normally (during a line), &#10;2) appearance when the barline is at the beginning or &#10;3) end of a line , and &#10;4) what to show when joining staffs together as with a Piano Staff.&#10;Barline forms are made of characters including |,:,.,[,],:&#10;and others in the LilyPond documentation."
msgstr "Izveidot pielāgotu taktsvītru.&#10;Tās var nosaukt vai vienkārši ignorēt standarta LilyPond taktsvītras tipu.&#10;Taktsvītru definē četras formas, kas apraksta 1) parasto izskatu (rindas vidū), &#10;2) izskatu, kad taktsvītra ir rindas sākumā, vai &#10;3) beigās, un &#10;4) ko rādīt, savienojot nošu līnijas, kā klavieru nošu līnijā.&#10;Taktsvītru formas veido rakstzīmes, tostarp |,:,.,[,],:&#10;un citas, kas minētas LilyPond dokumentācijā."

#: ../actions/palettes.xml.h:134
msgid "Repeats"
msgstr "Atkārtojumi"

#: ../actions/palettes.xml.h:135
msgid "(Print) start a first time bar, must be followed by EndVolta."
msgstr "(Druka) sākt pirmās reizes takti, tai jāseko EndVolta."

#: ../actions/palettes.xml.h:136
msgid "(Print) start a second time bar, must be followed by EndVolta"
msgstr "(Druka) sākt otrās reizes takti, tai jāseko EndVolta"

#: ../actions/palettes.xml.h:137
msgid "Ends a volta, that is a n'th time bar"
msgstr "Beidz voltu, t. i., n-tās reizes takti"

#: ../actions/palettes.xml.h:138
msgid "Inserts first and second time bars each with a whole measure rest.&#10;You can then edit this to suit your music, e.g by inserting extra bars, deleting the repeat start etc."
msgstr "Ievieto pirmās un otrās reizes taktis, katru ar visas takts pauzi.&#10;Pēc tam tās var rediģēt atbilstoši mūzikai, piem., ievietojot papildu taktis, dzēšot atkārtojuma sākumu u. c."

#: ../actions/palettes.xml.h:139
msgid "Start passage to be played on one or more of the repeats as indicated by the text given by the user (e.g.&#10;3 for third time bar).&#10;Finish the passage by placing the End ...&#10;time bar command."
msgstr "Sākt fragmentu, kas jāspēlē vienā vai vairākos atkārtojumos, kā norādīts lietotāja ievadītajā tekstā (piem.,&#10;3 — trešās reizes takts).&#10;Fragmentu pabeidziet, novietojot beigu ...&#10;reizes takts komandu."

#: ../actions/palettes.xml.h:140
msgid "Allow too few notes/rests in this measure.&#10;LilyPond will engrave this measure (in all staffs) with the short duration given by notes already present when this command was issued."
msgstr "Atļaut šajā taktī pārāk maz nošu/pauzu.&#10;LilyPond gravēs šo takti (visās nošu līnijās) ar īso ilgumu, ko nosaka komandas izpildes brīdī jau esošās notis."

#: ../actions/palettes.xml.h:141
msgid "Enter a number to change the lilypond bar number.&#10;The printout will continue to count up from there."
msgstr "Ievadiet skaitli, lai mainītu LilyPond takts numuru.&#10;Izdrukā skaitīšana turpināsies no tā."

#: ../actions/palettes.xml.h:143
msgid "Help with beaming commands."
msgstr "Palīdzība par svītrošanas komandām."

#: ../actions/palettes.xml.h:144
msgid "Instructs the LilyPond engraver to start a beam here.&#10;(Print effect only)"
msgstr "Liek LilyPond gravētājam šeit sākt svītru.&#10;(Ietekmē tikai drukāšanu)"

#: ../actions/palettes.xml.h:145
msgid "Instructs LilyPond engraver to stop previously started manual beaming.&#10;Print effect only."
msgstr "Liek LilyPond gravētājam beigt iepriekš sāktu manuālo svītrošanu.&#10;Ietekmē tikai drukāšanu."

#: ../actions/palettes.xml.h:155
msgid "Inserts a time signature with indication for how to beam the notes.&#10;Insert at beginning of staff in order to replace the initial time signature.&#10;Time Signature can be hidden on printing - see Time Signatures menu."
msgstr "Ievieto taktsmēru ar norādi, kā svītrot notis.&#10;Ievietojiet nošu līnijas sākumā, lai aizstātu sākotnējo taktsmēru.&#10;Taktsmēru drukājot var paslēpt — sk. izvēlni Taktsmēri."

#: ../actions/palettes.xml.h:156
msgid "Sets the rules to be used for beaming.&#10;With no selection gets the beat for beams to be divided for the prevailing time signature at the cursor.&#10;If a there is a selection this will set exceptions to the regular rule.&#10;In this case indicate the beaming desired using the manual beam commands [ and ]."
msgstr "Iestata svītrošanai izmantojamos noteikumus.&#10;Ja atlases nav, iegūst sitienu, pēc kura sadalīt svītras pašreizējam taktsmēram pie kursora.&#10;Ja ir atlase, tā iestatīs izņēmumus no parastā noteikuma.&#10;Šādā gadījumā norādiet vēlamo svītrojumu ar manuālajām svītru komandām [ un ]."

#: ../actions/palettes.xml.h:157
msgid "Add/Replace rules to be used for beaming in the current movement.&#10;With no selection gets the beat for beams to be divided for the prevailing time signature at the cursor.&#10;If a there is a selection this will be used as the set of rules.&#10;In this case indicate the beaming desired using the manual beam commands [ and ], giving all the beaming rules wanted using several measures if needed (no other rules are used).&#10;Repeat with different selections to add further rules."
msgstr "Pievienot/aizstāt pašreizējā daļā svītrošanai izmantojamos noteikumus.&#10;Ja atlases nav, iegūst sitienu, pēc kura sadalīt svītras pašreizējam taktsmēram pie kursora.&#10;Ja ir atlase, tā tiks izmantota kā noteikumu kopa.&#10;Šādā gadījumā norādiet vēlamo svītrojumu ar manuālajām svītru komandām [ un ], ja nepieciešams, norādot visus vajadzīgos svītrošanas noteikumus vairākās taktīs (citi noteikumi netiek izmantoti).&#10;Lai pievienotu vēl noteikumus, atkārtojiet ar citām atlasēm."

#: ../actions/palettes.xml.h:158
msgid "Inserts a time signature with indication for how to beam the notes.&#10;Insert at beginning of staff in order to replace the initial time signature."
msgstr "Ievieto taktsmēru ar norādi, kā svītrot notis.&#10;Ievietojiet nošu līnijas sākumā, lai aizstātu sākotnējo taktsmēru."

#: ../actions/palettes.xml.h:160
msgid "Add a bass figure to the current note.&#10;Use | sign to split the duration of a note so as to have multiple figures on one note.&#10;See Lilypond docs for other notation"
msgstr "Pievienot pašreizējai notij basa ciparu.&#10;Izmantojiet zīmi |, lai sadalītu nots ilgumu un vienai notij būtu vairāki cipari.&#10;Citu pierakstu skatiet LilyPond dokumentācijā"

#: ../actions/palettes.xml.h:161
msgid "Sets the height of the bass figure above the note.&#10;The unit is the distance between adjacent lines in the staff."
msgstr "Iestata basa cipara augstumu virs nots.&#10;Vienība ir attālums starp blakus esošām nošu līnijas līnijām."

#: ../actions/palettes.xml.h:163
msgid "Start filtering MIDI events, First note is bass, hold this down while entering notes for figures.&#10;Pedal changes harmony on same bass."
msgstr "Sākt filtrēt MIDI notikumus. Pirmā nots ir bass — turiet to nospiestu, ievadot ciparu notis.&#10;Pedālis maina harmoniju uz tā paša basa."

#: ../actions/palettes.xml.h:167
msgid "Mensural Notation"
msgstr "Menzurālā notācija"

#: ../actions/palettes.xml.h:168
msgid "Set this staff to use mensural notation (on/off)"
msgstr "Iestatīt šai nošu līnijai menzurālo notāciju (iesl./izsl.)"

#: ../actions/palettes.xml.h:169
msgid "Inserts a whole measure rest in mensural notation."
msgstr "Ievieto visas takts pauzi menzurālā notācijā."

#: ../actions/palettes.xml.h:170
msgid "Hides dots on the current chord/rest.&#10;Makes it conditional on the current layout."
msgstr "Slēpj punktus pašreizējā akordā/pauzē.&#10;Padara to atkarīgu no pašreizējā izkārtojuma."

#: ../actions/palettes.xml.h:171
msgid "Chord Symbols or Fake Chords"
msgstr "Akordu simboli"

#: ../actions/palettes.xml.h:172
msgid "Attach a chord symbol to the note at the cursor position.&#10;E.G.cis:dim7 for c-sharp diminished 7th.&#10;See Lilypond docs for notation"
msgstr "Pievienot akorda simbolu notij kursora pozīcijā.&#10;Piem., cis:dim7 — cis pamazinātais septakords.&#10;Pierakstu skatiet LilyPond dokumentācijā"

#: ../actions/palettes.xml.h:173
msgid "The current staff becomes a chord symbol staff.&#10;The music on this staff will be typeset as chord symbols.&#10;Normally you will make this staff a voice on the melody staff, so that the chord symbols print on the melody staff."
msgstr "Pašreizējā nošu līnija kļūst par akordu simbolu nošu līniju.&#10;Šīs nošu līnijas mūzika tiks salikta kā akordu simboli.&#10;Parasti šo nošu līniju padarīsiet par balsi melodijas nošu līnijā, lai akordu simboli tiktu izdrukāti melodijas nošu līnijā."

#: ../actions/palettes.xml.h:174
msgid "Midi Import"
msgstr "MIDI imports"

#: ../actions/palettes.xml.h:175
msgid "Opens a MIDI file for transcribing.&#10;Load each track in turn and insert the MIDI notes by playing the durations."
msgstr "Atver MIDI failu pārrakstīšanai.&#10;Ielādējiet katru celiņu pēc kārtas un ievietojiet MIDI notis, spēlējot ilgumus."

#: ../actions/palettes.xml.h:176
msgid "Starts playing the score from the playhead start (green marker bar) and simultaneously records your playing from MIDI in.&#10;        You can stop the playback at any time and then the first MIDI note you entered is marked.&#10;&#10;        Entering duration keys now enters the notes you played into the score.&#10;&#10;        If you have no click track at the top one is created."
msgstr "Sāk partitūras atskaņošanu no atskaņošanas sākuma (zaļā marķiera josla) un vienlaikus ieraksta jūsu spēli no MIDI ievades.&#10;        Atskaņošanu var apturēt jebkurā brīdī, un tad tiek atzīmēta pirmā ievadītā MIDI nots.&#10;&#10;        Ilguma taustiņu ievadīšana tagad ievada partitūrā jūsu nospēlētās notis.&#10;&#10;        Ja augšā nav klikšķu celiņa, tas tiek izveidots."

#: ../actions/palettes.xml.h:178
msgid "Creates a staff (a click track) at the top of this score from the imported MIDI using tempo and time signature information (if present).&#10;The measures are filled with drum beats so that pitches in the MIDI tracks can be displayed above them.&#10;When you have finished the import you can delete this staff."
msgstr "Izveido šīs partitūras augšā nošu līniju (klikšķu celiņu) no importētā MIDI, izmantojot tempa un taktsmēra informāciju (ja ir).&#10;Taktis tiek aizpildītas ar bungu sitieniem, lai virs tiem varētu attēlot MIDI celiņu skaņu augstumus.&#10;Kad imports pabeigts, šo nošu līniju var izdzēst."

#: ../actions/palettes.xml.h:179
msgid "Creates a staff below the click track for the MIDI track selected.&#10;The staff is empty except for time signature and tempo changes.&#10;The MIDI pitches from the track are displayed above the click track and notes can be inserted by double-clicking on a MIDI pitch and entering the rhythm."
msgstr "Izveido zem klikšķu celiņa nošu līniju izvēlētajam MIDI celiņam.&#10;Nošu līnija ir tukša, izņemot taktsmēra un tempa maiņas.&#10;Celiņa MIDI skaņu augstumi tiek attēloti virs klikšķu celiņa, un notis var ievietot, veicot dubultklikšķi uz MIDI skaņas augstuma un ievadot ritmu."

#: ../actions/palettes.xml.h:185
msgid "Moves to the next MIDI note onset in the current recorded or imported MIDI track.&#10;Inserted durations will take their pitch from this note."
msgstr "Pāriet uz nākamo MIDI nots sākumu pašreizējā ierakstītajā vai importētajā MIDI celiņā.&#10;Ievietotie ilgumi saņems augstumu no šīs nots."

#: ../actions/palettes.xml.h:186
msgid "Inserts the marked MIDI note from the current track, using the duration suggested.&#10;Use duration keys to insert the same note with a different duration."
msgstr "Ievieto atzīmēto MIDI noti no pašreizējā celiņa ar ieteikto ilgumu.&#10;Lai ievietotu to pašu noti ar citu ilgumu, izmantojiet ilguma taustiņus."

#: ../actions/palettes.xml.h:187
msgid "Ties"
msgstr "Līgas"

#: ../actions/palettes.xml.h:188
msgid "Gives a choice of shape modifications to make to the following tie."
msgstr "Piedāvā izvēlēties nākamās līgas formas modifikācijas."

#: ../actions/palettes.xml.h:189
msgid "The note at the cursor ends a tie that has begun elsewhere, usually in a first time bar.&#10;That is it is a repeat of the tie ending."
msgstr "Nots pie kursora beidz līgu, kas sākusies citur, parasti pirmās reizes taktī.&#10;Tas ir, tas ir līgas beigu atkārtojums."

#: ../actions/palettes.xml.h:190
msgid "Places a tie after the note at the cursor, tying to nothing.&#10;Use for laissez vibrer or when a tie comes at a final repeat."
msgstr "Novieto līgu aiz nots pie kursora, nesaistot to ne ar ko.&#10;Izmantojiet laissez vibrer gadījumā vai kad līga ir pie pēdējā atkārtojuma."

#: ../actions/palettes.xml.h:196
msgid "Corrects for the slur/tie error common in imported scores.&#10;Scans entire score for pairs of identical notes slurred together as a pair.&#10;Changes these to a tied note.&#10;Do not use in the unusual case of identical notes slurred (e.g.&#10;across strings)."
msgstr "Labo importētās partitūrās bieži sastopamo legato līgu/līgu kļūdu.&#10;Pārskata visu partitūru, meklējot vienādu nošu pārus, kas savienoti ar legato līgu.&#10;Pārveido tos par ar līgu saistītu noti.&#10;Neizmantojiet neparastajā gadījumā, kad vienādas notis savienotas ar legato līgu (piem.,&#10;pāri stīgām)."

#: ../actions/palettes.xml.h:197
msgid "Custom Ornaments"
msgstr "Pielāgoti melizmi"

#: ../actions/palettes.xml.h:198
msgid "Allows the user to create a customized ornament (or load one previously created)&#10;into this score's definitions.&#10;Ornament names should be start in lower case&#10;and have no numerals.&#10;If a standard ornament is used, e.g.&#10;trill,&#10;then this will replace the standard ornament throughout the score."
msgstr "Ļauj lietotājam izveidot pielāgotu melizmu (vai ielādēt iepriekš izveidotu)&#10;šīs partitūras definīcijās.&#10;Melizmu nosaukumiem jāsākas ar mazo burtu&#10;un tajos nedrīkst būt ciparu.&#10;Ja izmantots standarta melizms, piem.,&#10;trill,&#10;tas visā partitūrā aizstās standarta melizmu."

#: ../actions/palettes.xml.h:199
msgid "Edit the definition (size or appearance) of a custom ornament definition.&#10;The definition must already have been created in this score."
msgstr "Rediģēt pielāgotā melizma definīciju (izmēru vai izskatu).&#10;Definīcijai jau jābūt izveidotai šajā partitūrā."

#: ../actions/palettes.xml.h:200
msgid "Typesets a custom ornament on the current note/chord.&#10;Removes that ornament if already present."
msgstr "Saliek pielāgotu melizmu uz pašreizējās nots/akorda.&#10;Ja tas jau ir, noņem to."

#: ../actions/palettes.xml.h:201
msgid "Inserts an ornament (or other LilyPond Definition) as a separate object (it will appear on the previous note)"
msgstr "Ievieto melizmu (vai citu LilyPond definīciju) kā atsevišķu objektu (tas parādīsies uz iepriekšējās nots)"

#: ../actions/palettes.xml.h:202
msgid "Chord Charts"
msgstr "Akordu tabulas"

#: ../actions/palettes.xml.h:203
msgid "Prints Chord symbols separated by bar lines.&#10;Repeats, time signatures and text are also printed for this staff."
msgstr "Drukā akordu simbolus, atdalītus ar taktsvītrām.&#10;Šai nošu līnijai tiek drukāti arī atkārtojumi, taktsmēri un teksts."

#: ../actions/palettes.xml.h:204
msgid "Insert a previously created barline.&#10;(Any other LilyPond definitions  - see Score->LilyPond Definition - are here too)."
msgstr "Ievietot iepriekš izveidotu taktsvītru.&#10;(Šeit ir arī visas citas LilyPond definīcijas — sk. Partitūra->LilyPond definīcija.)"

#: ../actions/palettes.xml.h:205
msgid "Start a new line at this measure."
msgstr "Sākt jaunu rindu pie šīs takts."

#: ../actions/palettes.xml.h:207
msgid "Typeset the chord at the cursor larger or smaller than normal."
msgstr "Salikt akordu pie kursora lielāku vai mazāku nekā parasti."

#: ../actions/palettes.xml.h:209
msgid "Adds a bass note to a chord, while keeping the current lowest note as the root of the chord.&#10;Use this on Chord Symbol staffs to create an inversion of the chord entered."
msgstr "Pievieno akordam basa noti, saglabājot pašreizējo zemāko noti kā akorda pamatskaņu.&#10;Izmantojiet to akordu simbolu nošu līnijās, lai izveidotu ievadītā akorda apvērsumu."

#: ../actions/palettes.xml.h:210
msgid "Use in appending position to flatten the bass note of the next chord (extra to what it would be)."
msgstr "Izmantojiet pievienošanas pozīcijā, lai pazeminātu nākamā akorda basa noti (papildus tam, kāda tā būtu)."

#: ../actions/palettes.xml.h:211
msgid "Use in appending position to sharpen the bass note of the next chord (extra to what it would be)."
msgstr "Izmantojiet pievienošanas pozīcijā, lai paaugstinātu nākamā akorda basa noti (papildus tam, kāda tā būtu)."

#: ../actions/palettes.xml.h:212
msgid "Set the prevailing duration to &#x1D15D; (subsequent chords entered will have this duration)"
msgstr "Iestatīt pašreizējo ilgumu uz &#x1D15D; (turpmāk ievadītajiem akordiem būs šis ilgums)"

#: ../actions/palettes.xml.h:213
msgid "Set the prevailing duration to &#x1D15E; (subsequent chords entered will have this duration)"
msgstr "Iestatīt pašreizējo ilgumu uz &#x1D15E; (turpmāk ievadītajiem akordiem būs šis ilgums)"

#: ../actions/palettes.xml.h:214
msgid "Set the prevailing duration to &#x1D15F; (subsequent chords entered will have this duration)"
msgstr "Iestatīt pašreizējo ilgumu uz &#x1D15F; (turpmāk ievadītajiem akordiem būs šis ilgums)"

#: ../actions/palettes.xml.h:215
msgid "Insert a repeated chord sign."
msgstr "Ievietot atkārtota akorda zīmi."

#: ../actions/palettes.xml.h:216
msgid "Inserts an arbitrary mark in the score at the cursor.&#10;Any size, font, effect can be chosen.&#10;The text position can be dragged in the print view if needed.&#10;Avoid placing one at the start as it clashes with the time signature - place it after the first note and drag it into position."
msgstr "Ievieto partitūrā patvaļīgu zīmi pie kursora.&#10;Var izvēlēties jebkuru izmēru, fontu, efektu.&#10;Ja nepieciešams, teksta pozīciju var pārvilkt drukas skatā.&#10;Nenovietojiet to sākumā, jo tā sadurtos ar taktsmēru — novietojiet to aiz pirmās nots un pārvelciet vietā."

#: ../actions/palettes.xml.h:217
msgid "Specify the number of lines you want on the page."
msgstr "Norādiet, cik rindu vēlaties lappusē."

#: ../actions/palettes.xml.h:218
msgid "Inserts a non-printing whole measure after the current measure with a directive to omit the barline.&#10;This gives a one measure spacer."
msgstr "Ievieto aiz pašreizējās takts nedrukājamu visu takti ar direktīvu izlaist taktsvītru.&#10;Tas dod vienas takts atstarpi."

#: ../actions/palettes.xml.h:220
msgid "Turn the chord at the cursor into an alternate chord, typeset above and colored.&#10;This appears in the display as small notes (a grace note).&#10;Edit the position with the offset chord button."
msgstr "Pārvērst akordu pie kursora par alternatīvu akordu, saliktu virs un iekrāsotu.&#10;Attēlojumā tas parādās kā mazas notis (priekšnots).&#10;Pozīciju rediģējiet ar akorda nobīdes pogu."

#: ../actions/palettes.xml.h:223
msgid "Mutes the current staff.&#10;Affects only playback."
msgstr "Apklusina pašreizējo nošu līniju.&#10;Ietekmē tikai atskaņošanu."

#: ../actions/palettes.xml.h:224
msgid "Playback from start marker to end marker (Set these markers in the playback controls)"
msgstr "Atskaņot no sākuma marķiera līdz beigu marķierim (šos marķierus iestatiet atskaņošanas vadīklās)"

#: ../actions/palettes.xml.h:226
msgid "Plays all staffs for the duration of the selection or from the current cursor position to the end of the movement if no selection."
msgstr "Atskaņo visas nošu līnijas atlases ilgumā vai, ja atlases nav, no pašreizējās kursora pozīcijas līdz daļas beigām."

