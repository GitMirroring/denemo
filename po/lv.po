msgid "Left on Note Onset"
msgstr "Kreisais uz nots sākuma"

#: ../src/ui/mousing.c:1119
msgid "preparing to drag..."
msgstr "gatavojas vilkt..."

#: ../src/ui/mousing.c:1121
msgid "Start Playing Recording"
msgstr "Sākt ieraksta atskaņošanu"

