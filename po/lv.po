msgstr "Iestatīt nots galviņu"

#: ../src/core/entries.h:300
msgid "Change the type of notehead for the current note"
msgstr "Mainīt pašreizējās nots galviņas tipu"

#: ../src/core/entries.h:301
msgid "Auto Stemming"
msgstr "Automātiski kātiņi"

#: ../src/core/entries.h:301
msgid "Inserts a stem neutral object. After this automatic stem directions are active. You can click on this tag and use Sharpen/StemUp etc commands to change stem direction"
msgstr "Ievieto kātiņu neitrālu objektu. Pēc tā darbojas automātiski kātiņu virzieni. Varat noklikšķināt uz šīs birkas un izmantot komandas Paaugstināt/Kātiņš uz augšu u. c., lai mainītu kātiņu virzienu"

#: ../src/core/entries.h:302
msgid "Add Lyric Verse"
msgstr "Pievienot dziesmas vārdu pantu"

#: ../src/core/entries.h:302
msgid "Add a verse of lyrics"
msgstr "Pievienot dziesmas vārdu pantu"

#: ../src/core/entries.h:303
#: ../actions/menus/ObjectMenu/Lyrics/DeleteCurrentVerse.xml.h:1
msgid "Delete Verse"
msgstr "Dzēst pantu"

#: ../src/core/entries.h:303
msgid "Deletes current verse of lyrics from current voice"
msgstr "Dzēš pašreizējās balss pašreizējo dziesmas vārdu pantu"

#: ../src/core/entries.h:304
msgid "Insert/Edit Figured Bass"
msgstr "Ievietot/rediģēt ģenerālbasu"

#: ../src/core/entries.h:304
msgid "Add a bass figure to the current note. Use | sign to split the duration of a note so as to have multiple figures on one note. Directly insert the LilyPond syntax for the current note by enclosing it with $ signs. See Lilypond docs for other notation"
msgstr "Pievienot pašreizējai notij basa ciparu. Izmantojiet zīmi |, lai sadalītu nots ilgumu un vienai notij būtu vairāki cipari. Pašreizējās nots LilyPond sintaksi var ievietot tieši, ietverot to $ zīmēs. Citu pierakstu skatiet LilyPond dokumentācijā"

#: ../src/core/entries.h:305
msgid "Delete Figures"
msgstr "Dzēst ciparus"

#: ../src/core/entries.h:305 ../actions/palettes.xml.h:166
msgid "Delete the figured bass on the current staff"
msgstr "Dzēst ģenerālbasu pašreizējā nošu līnijā"

#: ../src/core/entries.h:306
msgid "Delete Chord Symbols"
msgstr "Dzēst akordu simbolus"

#: ../src/core/entries.h:306
