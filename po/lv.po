#: ../actions/menus/MainMenu/NavigationMenu/Bookmarks/SearchBookmark.xml.h:1
msgid "Search Bookmark"
msgstr "Meklēt grāmatzīmi"

#: ../actions/menus/MainMenu/NavigationMenu/Bookmarks/SearchBookmark.xml.h:2
msgid "Searches for a named Bookmark in the current staff."
msgstr "Meklē nosauktu grāmatzīmi pašreizējā nošu līnijā."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/CursorToHighestNote.xml.h:1
msgid "Cursor to Highest Note"
msgstr "Kursors uz augstāko noti"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/CursorToHighestNote.xml.h:2
msgid "Moves the cursor to the highest note on current horizontal position (in a chord or on a single note)"
msgstr "Pārvieto kursoru uz augstāko noti pašreizējā horizontālajā pozīcijā (akordā vai uz atsevišķas nots)"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/CursorToLowestNote.xml.h:1
msgid "Cursor to Lowest Note"
msgstr "Kursors uz zemāko noti"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/CursorToLowestNote.xml.h:2
msgid "Moves the cursor to the lowest note on current horizontal position (in a chord or on a single note)"
msgstr "Pārvieto kursoru uz zemāko noti pašreizējā horizontālajā pozīcijā (akordā vai uz atsevišķas nots)"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/GoToTypesetMeasureNumber.scm:5
msgid "Give destination: "
msgstr "Ievadiet mērķi: "

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/GoToTypesetMeasureNumber.xml.h:1
msgid "Go To Typeset Measure Number"
msgstr "Pāriet uz saliktās takts numuru"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/GoToTypesetMeasureNumber.xml.h:2
msgid "Goes to the measure number given taking into account any measure offset (normally this will be set to be the measure number as typeset)."
msgstr "Pāriet uz norādīto takts numuru, ņemot vērā takts nobīdi (parasti tā būs iestatīta, lai atbilstu saliktajam takts numuram)."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpDownOctave.xml.h:2
msgid "Moves cursor down an octave."
msgstr "Pārvieto kursoru oktāvu zemāk."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpLeft.xml.h:1
msgid "JumpLeft"
msgstr "Lēciens pa kreisi"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpLeft.xml.h:2
msgid "Jumps to beginning of this measure or previous measure."
msgstr "Pāriet uz šīs vai iepriekšējās takts sākumu."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpRight.xml.h:1
msgid "JumpRight"
msgstr "Lēciens pa labi"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpRight.xml.h:2
msgid "Moves cursor to start of next bar or to end."
msgstr "Pārvieto kursoru uz nākamās takts sākumu vai uz beigām."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/JumpUpOctave.xml.h:2
msgid "Moves cursor up one octave."
msgstr "Pārvieto kursoru oktāvu augstāk."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToMovementBeginning.xml.h:1
msgid "Move To Movement Beginning"
msgstr "Pāriet uz daļas sākumu"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToMovementBeginning.xml.h:2
msgid "Moves the cursor to the beginning of the movement without altering the selection"
msgstr "Pārvieto kursoru uz daļas sākumu, nemainot atlasi"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToMovementEnd.xml.h:1
msgid "Move To Movement End"
msgstr "Pāriet uz daļas beigām"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToMovementEnd.xml.h:2
msgid "Move the cursor to last measure, last staff without altering the selection."
msgstr "Pārvietot kursoru uz pēdējo takti, pēdējo nošu līniju, nemainot atlasi."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToStaffDownAppending.xml.h:1
msgid "Move to Staff Down, Appending"
msgstr "Pāriet uz apakšējo nošu līniju, pievienojot"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToStaffDownAppending.xml.h:2
msgid "Moves to the appending position in the staff below."
msgstr "Pāriet uz pievienošanas pozīciju apakšējā nošu līnijā."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToStaffUpAppending.xml.h:1
msgid "Move to Staff Up, Appending"
msgstr "Pāriet uz augšējo nošu līniju, pievienojot"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/MoveToStaffUpAppending.xml.h:2
msgid "Moves to the appending position in the staff above."
msgstr "Pāriet uz pievienošanas pozīciju augšējā nošu līnijā."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/ToNextNote.xml.h:1
msgid "Cursor To Next Note"
msgstr "Kursors uz nākamo noti"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/ToNextNote.xml.h:2
msgid "Moves to the next note, topping at blank measures. Sounds a warning if no more notes."
msgstr "Pāriet uz nākamo noti, apstājoties pie tukšām taktīm. Ja nošu vairs nav, atskan brīdinājums."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/VisibleStaffDown.xml.h:1
msgid "Move to Visible Staff Down"
msgstr "Pāriet uz zemāko redzamo nošu līniju"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/VisibleStaffDown.xml.h:2
msgid "Moves to the next staff or voice down skipping ones that are hidden in the display."
msgstr "Pāriet uz nākamo nošu līniju vai balsi uz leju, izlaižot attēlojumā paslēptās."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/VisibleStaffUp.xml.h:1
msgid "Move to Visible Staff Up"
msgstr "Pāriet uz augstāko redzamo nošu līniju"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/VisibleStaffUp.xml.h:2
msgid "Moves to the next staff or voice up skipping ones that are hidden in the display."
msgstr "Pāriet uz nākamo nošu līniju vai balsi uz augšu, izlaižot attēlojumā paslēptās."

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/WrapToNextStaff.xml.h:1
msgid "Next Staff, Wrapping"
msgstr "Nākamā nošu līnija ar aplaušanu"

#: ../actions/menus/MainMenu/NavigationMenu/Cursor/WrapToNextStaff.xml.h:2
msgid "Moves to the next staff, wrapping to the first staff when on the last staff."
msgstr "Pāriet uz nākamo nošu līniju; pēdējā nošu līnijā pāriet uz pirmo."

#: ../actions/menus/MainMenu/NavigationMenu/DenemoLink.scm:19
msgid "The cursor is "
msgstr "Kursors ir "

#: ../actions/menus/MainMenu/NavigationMenu/DenemoLink.scm:23
msgid "There is no link before this bar in this staff, open the source document and click on it to place one."
msgstr "Šajā nošu līnijā pirms šīs takts nav saites — atveriet avota dokumentu un noklikšķiniet uz tā, lai to novietotu."

#: ../actions/menus/MainMenu/NavigationMenu/DenemoLink.xml.h:1
msgid "Follow Link to Source"
msgstr "Sekot saitei uz avotu"

#: ../actions/menus/MainMenu/NavigationMenu/DenemoLink.xml.h:2
msgid "Follows the link at or before the cursor to a source document."
msgstr "Seko saitei pie kursora vai pirms tā uz avota dokumentu."

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/CursorToMarkedMidiNotePosition.xml.h:1
msgid "Cursor to Marked Onset"
msgstr "Kursors uz atzīmēto sākumu"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/CursorToMarkedMidiNotePosition.xml.h:2
msgid "Moves the Denemo cursor to the note to which the marked MIDI note onset belongs."
msgstr "Pārvieto Denemo kursoru uz noti, kurai pieder atzīmētais MIDI nots sākums."

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/FirstNoteOnset.scm:5
#: ../actions/menus/MainMenu/NavigationMenu/MIDI/NextNoteOnset.scm:8
#: ../actions/menus/MainMenu/NavigationMenu/MIDI/PreviousNoteOnset.scm:8
#: ../actions/menus/MainMenu/NavigationMenu/MIDI/UnmarkNoteOnset.scm:5
msgid "No MIDI file has been loaded"
msgstr "Nav ielādēts neviens MIDI fails"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/FirstNoteOnset.xml.h:1
msgid "First Note Onset"
msgstr "Pirmās nots sākums"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/FirstNoteOnset.xml.h:2
#: ../actions/palettes.xml.h:182
msgid "The first recorded or imported MIDI note onset in the current track becomes marked so that entered durations will be given its pitch."
msgstr "Pašreizējā celiņa pirmais ierakstītais vai importētais MIDI nots sākums tiek atzīmēts, lai ievadītajiem ilgumiem tiktu piešķirts tā augstums."

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/NextNoteOnset.scm:7
#: ../actions/menus/MainMenu/NavigationMenu/MIDI/PreviousNoteOnset.scm:7
msgid "No Onset has been marked"
msgstr "Nav atzīmēts neviens sākums"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/NextNoteOnset.xml.h:1
msgid "Next Note Onset"
msgstr "Nākamās nots sākums"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/NextNoteOnset.xml.h:2
msgid "Moves to the next MIDI note onset in the current recorded or imported MIDI track. Inserted durations will take their pitch from this note."
msgstr "Pāriet uz nākamo MIDI nots sākumu pašreizējā ierakstītajā vai importētajā MIDI celiņā. Ievietotie ilgumi saņems augstumu no šīs nots."

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/PreviousNoteOnset.xml.h:1
msgid "Previous Note Onset"
msgstr "Iepriekšējās nots sākums"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/PreviousNoteOnset.xml.h:2
#: ../actions/palettes.xml.h:184
msgid "Moves the marked MIDI note onset to the one before the current one."
msgstr "Pārvieto atzīmēto MIDI nots sākumu uz iepriekšējo."

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/UnmarkNoteOnset.xml.h:1
msgid "Un-mark Note Onsets"
msgstr "Noņemt nošu sākumu atzīmes"

#: ../actions/menus/MainMenu/NavigationMenu/MIDI/UnmarkNoteOnset.xml.h:2
#: ../actions/palettes.xml.h:183
msgid "Removes the mark from the MIDI note onset, so that inserting durations have their normal meaning."
msgstr "Noņem atzīmi no MIDI nots sākuma, lai ievietotajiem ilgumiem būtu to parastā nozīme."

#: ../actions/menus/MainMenu/NavigationMenu/MoveViewportLeft.xml.h:1
#: ../actions/menus/MainMenu/NavigationMenu/MoveViewportRight.xml.h:1
msgid "Move Display Right"
msgstr "Pārvietot attēlojumu pa labi"

#: ../actions/menus/MainMenu/NavigationMenu/MoveViewportLeft.xml.h:2
msgid "Moves the view port (the Denemo Display) to the left, leaving the cursor on the same object as long as it is still in view."
msgstr "Pārvieto skatlauku (Denemo attēlojumu) pa kreisi, atstājot kursoru uz tā paša objekta, kamēr tas ir redzams."

#: ../actions/menus/MainMenu/NavigationMenu/MoveViewportRight.xml.h:2
msgid "Moves the view port (the Denemo Display) to the right, leaving the cursor on the same object as long as it is still in view."
msgstr "Pārvieto skatlauku (Denemo attēlojumu) pa labi, atstājot kursoru uz tā paša objekta, kamēr tas ir redzams."

#.
#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindEditPoint.xml.h:1
msgid "Find Edit Point"
msgstr "Atrast rediģēšanas punktu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindEditPoint.xml.h:2
msgid "Searches backward for the start of non-printing notes."
msgstr "Meklē atpakaļ nedrukājamu nošu sākumu."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNextLowerNote.xml.h:1
msgid "Next Lower"
msgstr "Nākamā zemākā"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNextLowerNote.xml.h:2
msgid "Moves cursor to next note that is lower than the cursor."
msgstr "Pārvieto kursoru uz nākamo noti, kas ir zemāka par kursoru."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNextSimilar.xml.h:1
msgid "Find Next Similar"
msgstr "Atrast nākamo līdzīgo"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNextSimilar.xml.h:2
msgid "Finds the next object similar to the one at the cursor."
msgstr "Atrod nākamo objektu, kas līdzīgs objektam pie kursora."

#.
#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNote.xml.h:1
msgid "Find Note"
msgstr "Atrast noti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/FindNote.xml.h:2
msgid "Moves the cursor forward until it is on the note given by the user."
msgstr "Pārvieto kursoru uz priekšu, līdz tas atrodas uz lietotāja norādītās nots."

#. GoToEmptyMeasure
#: ../actions/menus/MainMenu/NavigationMenu/Seek/GoToEmptyMeasure.xml.h:1
msgid "Go To Next Empty Measure"
msgstr "Pāriet uz nākamo tukšo takti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/GoToEmptyMeasure.xml.h:2
msgid "Move cursor to the next point in the current staff where the music ends."
msgstr "Pārvietot kursoru uz nākamo vietu pašreizējā nošu līnijā, kur mūzika beidzas."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/GoToMeasureEnd.xml.h:1
msgid "Go To End of Measure"
msgstr "Pāriet uz takts beigām"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/MoveToEarliestEmptyMeasure.xml.h:1
msgid "Move to Earliest Empty Measure"
msgstr "Pāriet uz agrāko tukšo takti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/MoveToEarliestEmptyMeasure.xml.h:2
msgid "Moves the cursor back until the a non-empty measure is found. Stops in the empty measure after that."
msgstr "Pārvieto kursoru atpakaļ, līdz atrasta netukša takts. Apstājas tukšajā taktī aiz tās."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/MoveToPreviousEmptyMeasure.xml.h:1
msgid "Move To Previous Empty Measure"
msgstr "Pāriet uz iepriekšējo tukšo takti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/MoveToPreviousEmptyMeasure.xml.h:2
msgid "Move the cursor left until it finds an empty measure or the staffs beginning"
msgstr "Pārvietot kursoru pa kreisi, līdz tas atrod tukšu takti vai nošu līnijas sākumu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/NextHigher.xml.h:1
msgid "Next Higher"
msgstr "Nākamā augstākā"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/NextHigher.xml.h:2
msgid "Move cursor to next note higher than cursor position"
msgstr "Pārvietot kursoru uz nākamo noti, kas ir augstāka par kursora pozīciju"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:8
msgid "New search music from selection"
msgstr "Jauna mūzikas meklēšana no atlases"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:9
msgid "Resume previous music search"
msgstr "Atsākt iepriekšējo mūzikas meklēšanu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:32
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:33
msgid "Make a selection to search for"
msgstr "Izveidojiet meklējamo atlasi"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:62
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:66
msgid "Continue"
msgstr "Turpināt"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:72
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:79
msgid "Wrap to start of staff"
msgstr "Pāriet uz nošu līnijas sākumu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.scm:73
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:80
msgid "Wrap to next staff"
msgstr "Pāriet uz nākamo nošu līniju"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.xml.h:1
msgid "Search Note Sequence"
msgstr "Meklēt nošu secību"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchMusic.xml.h:2
msgid "With a selection, searches from the cursor for the next occurrence of the notes of the selection. With no selection, continues the previous search. When a match (ignoring rests and duration) is found it offers to continue, stop or execute the script in the Scheme Window."
msgstr "Ja ir atlase, meklē no kursora nākamo atlases nošu parādīšanos. Ja atlases nav, turpina iepriekšējo meklēšanu. Kad atrasta atbilstība (ignorējot pauzes un ilgumu), piedāvā turpināt, apstāties vai izpildīt Scheme loga skriptu."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:8
msgid "New search pattern from selection"
msgstr "Jauns meklēšanas raksts no atlases"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.scm:9
msgid "Resume previous search"
msgstr "Atsākt iepriekšējo meklēšanu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.xml.h:1
msgid "Search Rhythmic Pattern"
msgstr "Meklēt ritma rakstu"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SearchPattern.xml.h:2
msgid "With a selection, searches from the cursor for the next occurrence of the rhythmic patterm of the selection. With no selection, continues the previous search. When a match is found it offers to continue, stop or execute the script in the Scheme Window."
msgstr "Ja ir atlase, meklē no kursora nākamo atlases ritma raksta parādīšanos. Ja atlases nav, turpina iepriekšējo meklēšanu. Kad atrasta atbilstība, piedāvā turpināt, apstāties vai izpildīt Scheme loga skriptu."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:36
msgid "Search locations in all staffs"
msgstr "Meklēt vietas visās nošu līnijās"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:36
msgid "Search in only in staff"
msgstr "Meklēt tikai nošu līnijā"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:36
msgid "Choose where to search"
msgstr "Izvēlieties, kur meklēt"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:40
msgid "Key Signature Changes"
msgstr "Toņkārtas maiņas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:41
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:86
msgid "Time Signature Changes"
msgstr "Taktsmēra maiņas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:42
msgid "Changes of Clef"
msgstr "Atslēgas maiņas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:43
#: ../actions/menus/ObjectMenu/NotesRests/Markings/Ornaments/OrnamentWithAccidentals.scm:16
msgid "Custom"
msgstr "Pielāgots"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:47
msgid "Notes Higher Than Note"
msgstr "Notis, kas augstākas par noti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:48
msgid "Notes Lower Than Note"
msgstr "Notis, kas zemākas par noti"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:52
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:96
msgid "Denemo Directives tagged"
msgstr "Denemo direktīvas ar birku"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:58
msgid "Note lower than"
msgstr "Nots zemāka par"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:69
msgid "Note higher than"
msgstr "Nots augstāka par"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:81
msgid "Key Changes"
msgstr "Toņkārtas maiņas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:91
msgid "Clef Changes"
msgstr "Atslēgas maiņas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:106
msgid ""
"You need a Scheme expression Scheme Script window\n"
"to use this option\n"
"Locations where the expression evaluates are true will be found."
msgstr ""
"Lai izmantotu šo opciju, Scheme skripta logā\n"
"nepieciešama Scheme izteiksme\n"
"Tiks atrastas vietas, kur izteiksme ir patiesa."

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:107
msgid "Install a template script in the Scheme Script window"
msgstr "Uzstādīt veidnes skriptu Scheme skripta logā"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:107
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.xml.h:1
msgid "Seek Locations"
msgstr "Meklēt vietas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:110
msgid "Open View->Scheme Script to edit the script to test for the locations you want to find"
msgstr "Atveriet Skats->Scheme skripts, lai rediģētu skriptu, kas pārbauda meklējamās vietas"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:124
msgid "No locations found"
msgstr "Nav atrasta neviena vieta"

#. (disp "menu-choices " menu-choices " \n\nwhich is a list " (list? menu-choices) "\n\n")
#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.scm:128
msgid "Choose a location to go to (Movement, Staff, Measure, Object) and click OK"
msgstr "Izvēlieties vietu, uz kuru pāriet (daļa, nošu līnija, takts, objekts), un noklikšķiniet uz Labi"

#: ../actions/menus/MainMenu/NavigationMenu/Seek/SeekLocations.xml.h:2
msgid "Seek for locations in the score satisfying a certain condition e.g. exceeding a range or at a clef change etc. A list of such locations is created which can be selected from. Repeating the command after choosing one location re-presents the remainder of the list."
msgstr "Meklēt partitūrā vietas, kas atbilst noteiktam nosacījumam, piem., pārsniedz diapazonu vai atrodas pie atslēgas maiņas u. c. Tiek izveidots šādu vietu saraksts, no kura var izvēlēties. Atkārtojot komandu pēc vienas vietas izvēles, tiek atkal parādīta saraksta atlikusī daļa."

#. (fixMeasures) loops infinitely?
#: ../actions/menus/MainMenu/PlaybackMenu/ConvertMidiForBass.xml.h:1
msgid "Convert MIDI Chords Over Bass"
msgstr "Pārveidot MIDI akordus virs basa"

#: ../actions/menus/MainMenu/PlaybackMenu/ConvertMidiForBass.xml.h:2
msgid "Takes a MIDI recording over a bass line and inserts the chords by matching the bass notes. Each chord must include the bass note."
msgstr "Paņem MIDI ierakstu virs basa līnijas un ievieto akordus, saskaņojot basa notis. Katrā akordā jābūt basa notij."

#: ../actions/menus/MainMenu/PlaybackMenu/DenemoPlayCursorToEnd.xml.h:1
msgid "Play from Cursor to End"
msgstr "Atskaņot no kursora līdz beigām"

#: ../actions/menus/MainMenu/PlaybackMenu/DenemoPlayCursorToEnd.xml.h:2
msgid "Playback all staffs from the current cursor position to the end of the movement."
msgstr "Atskaņot visas nošu līnijas no pašreizējās kursora pozīcijas līdz daļas beigām."

#: ../actions/menus/MainMenu/PlaybackMenu/Performance.scm:48
#: ../actions/menus/MainMenu/PlaybackMenu/Performance.scm:59
msgid "No fine found, assuming all"
msgstr "Nav atrasts fine, pieņem visu"

#: ../actions/menus/MainMenu/PlaybackMenu/Performance.scm:55
msgid "Dal Segno with no Segno - assuming Da Capo"
msgstr "Dal Segno bez Segno — pieņem Da Capo"

#: ../actions/menus/MainMenu/PlaybackMenu/Performance.xml.h:1
msgid "Performance (Start/Stop)"
msgstr "Izpildījums (sākt/apturēt)"

#: ../actions/menus/MainMenu/PlaybackMenu/Performance.xml.h:2
msgid "Plays the current movement, observing repeats, Da Capo, fine and Dal Segno. If playing stops the performance"
msgstr "Atskaņo pašreizējo daļu, ievērojot atkārtojumus, Da Capo, fine un Dal Segno. Ja atskaņo — aptur izpildījumu"

#. PitchShift
#: ../actions/menus/MainMenu/PlaybackMenu/PitchShift.scm:2
msgid "Pitch Change"
msgstr "Skaņas augstuma maiņa"

#: ../actions/menus/MainMenu/PlaybackMenu/PitchShift.scm:2
msgid "Give amount =/-"
msgstr "Ievadiet daudzumu =/-"

#: ../actions/menus/MainMenu/PlaybackMenu/PitchShift.xml.h:1
msgid "Shift Pitch"
msgstr "Pārbīdīt skaņas augstumu"

#: ../actions/menus/MainMenu/PlaybackMenu/PitchShift.xml.h:2
msgid "Outputs a pitch bend signal to the synthesizer for the value +/- 64 given."
msgstr "Izvada sintezatoram skaņas augstuma maiņas signālu ar norādīto vērtību +/- 64."

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAllAtCursor.xml.h:1
msgid "Play Music at Cursor"
msgstr "Atskaņot mūziku pie kursora"

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAllAtCursor.xml.h:2
msgid "Plays the score for the duration of the note/chord at the cursor, starting at that note."
msgstr "Atskaņo partitūru nots/akorda pie kursora ilgumā, sākot ar šo noti."

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAll.xml.h:1
msgid "Play All"
msgstr "Atskaņot visu"

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAll.xml.h:2
msgid "Plays the current movement from the start, observing any mute objects placed in the staffs."
msgstr "Atskaņo pašreizējo daļu no sākuma, ievērojot nošu līnijās novietotos apklusināšanas objektus."

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAndRecordMidiIn.xml.h:1
msgid "Playback and Record MIDI (Off/On)"
msgstr "Atskaņot un ierakstīt MIDI (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAndRecordMidiIn.xml.h:2
msgid "Starts (or stops) playing the score from the playhead start (green marker bar) and simultaneously records your playing from MIDI in. You can stop the playback at any time and then the first MIDI note you entered is marked. Entering duration keys now enters the notes you played into the score. If you have no click track at the top one is created - set the keysignature/enharmonic range before you start."
msgstr "Sāk (vai aptur) partitūras atskaņošanu no atskaņošanas sākuma (zaļā marķiera josla) un vienlaikus ieraksta jūsu spēli no MIDI ievades. Atskaņošanu var apturēt jebkurā brīdī, un tad tiek atzīmēta pirmā ievadītā MIDI nots. Ilguma taustiņu ievadīšana tagad ievada partitūrā jūsu nospēlētās notis. Ja augšā nav klikšķu celiņa, tas tiek izveidots — pirms sākšanas iestatiet toņkārtu/enharmonisko diapazonu."

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAtCursor.xml.h:1
msgid "Play Chord at Cursor"
msgstr "Atskaņot akordu pie kursora"

#: ../actions/menus/MainMenu/PlaybackMenu/PlayAtCursor.xml.h:2
msgid "Sounds the note or chord at the cursor, using the current staffs instrument."
msgstr "Atskaņo noti vai akordu pie kursora, izmantojot pašreizējās nošu līnijas instrumentu."

#: ../actions/menus/MainMenu/PlaybackMenu/PlaybackView.scm:3
msgid "Please turn continuous typsetting off first"
msgstr "Lūdzu, vispirms izslēdziet nepārtraukto salikšanu"

#: ../actions/menus/MainMenu/PlaybackMenu/PlaybackView.scm:33
msgid "You should typeset this movement first in the Print View, otherwise positioning may not work."
msgstr "Vispirms šī daļa jāsaliek drukas skatā, citādi pozicionēšana var nedarboties."

#: ../actions/menus/MainMenu/PlaybackMenu/PlaybackView.xml.h:2
msgid "Displays the music fully typeset on one long page (the Playback View). Click on a note to play from there or drag to loop play."
msgstr "Parāda pilnībā saliktu mūziku vienā garā lappusē (atskaņošanas skats). Noklikšķiniet uz nots, lai atskaņotu no tās, vai velciet, lai atskaņotu cilpā."

#: ../actions/menus/MainMenu/PlaybackMenu/PlayPause.xml.h:1
msgid "Play/Pause"
msgstr "Atskaņot/pauze"

#: ../actions/menus/MainMenu/PlaybackMenu/PlayPause.xml.h:2
msgid "Plays from the playback start marker in the current movement or Pauses if playing"
msgstr "Atskaņo no atskaņošanas sākuma marķiera pašreizējā daļā vai pauzē, ja atskaņo"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.scm:15
msgid "Time at Denemo Cursor "
msgstr "Laiks pie Denemo kursora "

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.scm:16
msgid "Time at Marked MIDI note "
msgstr "Laiks pie atzīmētās MIDI nots "

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.scm:17
msgid ""
"Move the Denemo Cursor to another position and click on the MIDI note that should appear at that position\n"
"And then re-execute this command."
msgstr ""
"Pārvietojiet Denemo kursoru uz citu pozīciju un noklikšķiniet uz MIDI nots, kurai jāparādās šajā pozīcijā\n"
"Un pēc tam izpildiet šo komandu vēlreiz."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.scm:27
msgid "Re-scaling out of range"
msgstr "Pārmērogošana ārpus diapazona"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.scm:28
msgid "Wrongly ordered adjustement points"
msgstr "Nepareizā secībā sakārtoti pielāgošanas punkti"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.xml.h:1
msgid "Adjust Tempo to Recording"
msgstr "Pielāgot tempu ierakstam"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/AdjustTempoToMidiRecording.xml.h:2
msgid "Adjusts the movement tempo to match the tempo of the MIDI recording. You have to designate two places to be synchronized."
msgstr "Pielāgo daļas tempu MIDI ieraksta tempam. Jānorāda divas sinhronizējamas vietas."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/AudioPlay.xml.h:2
msgid "Plays the audio attached to the current movement. Use File-&gt;Open Audio to attach audio."
msgstr "Atskaņo pašreizējai daļai pievienoto audio. Lai pievienotu audio, izmantojiet Fails-&gt;Atvērt audio."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/CloseSourceAudioFile.xml.h:1
msgid "Delete Audio Recording"
msgstr "Dzēst audio ierakstu"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/CloseSourceAudioFile.xml.h:2
msgid "Deletes the current audio recording."
msgstr "Dzēš pašreizējo audio ierakstu."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/RecordAndAttach.scm:19
msgid ""
"Play music you want to insert next\n"
"Then re-issue this command."
msgstr ""
"Nospēlējiet mūziku, ko vēlaties ievietot nākamo,\n"
"pēc tam izsauciet šo komandu vēlreiz."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/RecordAndAttach.scm:29
msgid ""
"Now the music is attached to the score starting at the cursor position.\n"
"The timing of the notes is shown at the top of the score.\n"
"You can drag the timing of start of the music by left-clicking above the blue line.\n"
"You can insert the rhythm in your staff and check by invoking Play.\n"
"When that's correct, press the Shift key to switch to Inserting/Appending Pitches and play in the music again."
msgstr ""
"Tagad mūzika ir pievienota partitūrai, sākot no kursora pozīcijas.\n"
"Nošu laiki redzami partitūras augšā.\n"
"Mūzikas sākuma laiku var pārvilkt, ar kreiso pogu noklikšķinot virs zilās līnijas.\n"
"Ritmu var ievietot savā nošu līnijā un pārbaudīt, izsaucot Atskaņot.\n"
"Kad tas ir pareizs, nospiediet taustiņu Shift, lai pārslēgtos uz skaņu augstumu ievietošanu/pievienošanu, un vēlreiz nospēlējiet mūziku."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/RecordAndAttach.xml.h:1
msgid "Record (Start/Stop) and Attach at Cursor"
msgstr "Ierakstīt (sākt/apturēt) un pievienot pie kursora"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/RecordAndAttach.xml.h:2
msgid "The first invocation of this command starts recording - play the melody you want to notate. Then invoke the command again to stop the recording - the audio is attached to an (optional) click track created at the top of the staffs. The recording will play along with your notated music - ensure you have enough filled measures after the cursor to attach the audio to otherwise it won't play."
msgstr "Pirmais šīs komandas izsaukums sāk ierakstīšanu — nospēlējiet melodiju, ko vēlaties notēt. Pēc tam izsauciet komandu vēlreiz, lai apturētu ierakstīšanu — audio tiek pievienots (pēc izvēles) klikšķu celiņam, kas izveidots nošu līniju augšā. Ieraksts skanēs kopā ar jūsu notēto mūziku — pārliecinieties, ka aiz kursora ir pietiekami daudz aizpildītu taktu, kam pievienot audio, citādi tas neskanēs."

#. SaveRecording
#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/SaveRecording.xml.h:1
msgid "Save Recording"
msgstr "Saglabāt ierakstu"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/SaveRecording.xml.h:2
msgid "Saves the recorded autio to disk."
msgstr "Saglabā ierakstīto audio diskā."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/SynchronizeAudio.xml.h:1
msgid "Synchronize Audio"
msgstr "Sinhronizēt audio"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/SynchronizeAudio.xml.h:2
msgid "Plays the audio attached to the current movement. Creates a timing bar for each space bar press. Music written in the staffs below will synchronize with the audio."
msgstr "Atskaņo pašreizējai daļai pievienoto audio. Katram atstarpes taustiņa nospiedienam izveido laika joslu. Zemāk esošajās nošu līnijās rakstītā mūzika sinhronizēsies ar audio."

#. ToggleAudioRecord
#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/ToggleAudioRecord.xml.h:1
msgid "Record (Start/Stop)"
msgstr "Ierakstīt (sākt/apturēt)"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/Audio/ToggleAudioRecord.xml.h:2
msgid "Starts/Stops recording the audio output from Denemo."
msgstr "Sāk/aptur Denemo audio izvades ierakstīšanu."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/BackupAndPlay.xml.h:1
msgid "Backup and Play Marked MIDI Note."
msgstr "Atkāpties un atskaņot atzīmēto MIDI noti."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/BackupAndPlay.xml.h:2
msgid "Moves the marked MIDI note one note earlier and plays that."
msgstr "Pārvieto atzīmēto MIDI noti par vienu noti agrāk un atskaņo to."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteLastRecordedMidi.xml.h:1
msgid "Delete Last Recorded Note"
msgstr "Dzēst pēdējo ierakstīto noti"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteLastRecordedMidi.xml.h:2
msgid "Plays the last recorded note, deletes it and marks the new last note."
msgstr "Atskaņo pēdējo ierakstīto noti, izdzēš to un atzīmē jauno pēdējo noti."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteMidiAndClickTrack.xml.h:1
msgid "Delete Recorded MIDI and Click Track"
msgstr "Dzēst ierakstīto MIDI un klikšķu celiņu"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteMidiAndClickTrack.xml.h:2
msgid "Deletes the MIDI recording and the click track that shows it and any trailing blank measures."
msgstr "Dzēš MIDI ierakstu un klikšķu celiņu, kas to attēlo, kā arī visas tukšās taktis beigās."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteRecordedMidi.xml.h:1
msgid "Delete Imported/Recorded Midi"
msgstr "Dzēst importēto/ierakstīto MIDI"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/DeleteRecordedMidi.xml.h:2
#: ../actions/palettes.xml.h:177
msgid "Deletes the MIDI that has been imported or recorded via MIDI in."
msgstr "Dzēš importēto vai caur MIDI ievadi ierakstīto MIDI."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/PlayAndAdvance.xml.h:1
msgid "Play and Advance Marked Midi Note"
msgstr "Atskaņot un pavirzīt atzīmēto MIDI noti"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/PlayAndAdvance.xml.h:2
msgid "Plays the marked recorded MIDI note and advances the mark."
msgstr "Atskaņo atzīmēto ierakstīto MIDI noti un pavirza atzīmi."

#. PlayRecordedMidi
#: ../actions/menus/MainMenu/PlaybackMenu/Recording/PlayRecordedMidi.xml.h:1
msgid "Play Recorded MIDI (Off/On)"
msgstr "Atskaņot ierakstīto MIDI (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/PlayRecordedMidi.xml.h:2
msgid "Plays the recorded MIDI track from the marked MIDI note or beginning if no note is marked. Stops playing if already playing MIDI track."
msgstr "Atskaņo ierakstīto MIDI celiņu no atzīmētās MIDI nots vai no sākuma, ja nots nav atzīmēta. Ja MIDI celiņš jau skan, aptur atskaņošanu."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/RecordMidiIn.xml.h:1
msgid "Record from MIDI in (Off/On)"
msgstr "Ierakstīt no MIDI ievades (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/RecordMidiIn.xml.h:2
msgid "Records/Stops recording notes played on MIDI keyboard. Notes are recorded on a track above a click track staff at the top of the score. Insert the notes into the score by pressing duration keys/Ins key."
msgstr "Ieraksta/aptur uz MIDI klaviatūras nospēlēto nošu ierakstīšanu. Notis tiek ierakstītas celiņā virs klikšķu celiņa nošu līnijas partitūras augšā. Ievietojiet notis partitūrā, spiežot ilguma taustiņus/taustiņu Ins."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SetMarkedMidiFromEnd.scm:3
msgid "Repositioning Marked MIDI Note"
msgstr "Atzīmētās MIDI nots pārvietošana"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SetMarkedMidiFromEnd.scm:3
msgid "Give interval back from end (seconds):"
msgstr "Ievadiet intervālu atpakaļ no beigām (sekundes):"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SetMarkedMidiFromEnd.xml.h:1
msgid "Reposition Relative to End"
msgstr "Pārvietot attiecībā pret beigām"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SetMarkedMidiFromEnd.xml.h:2
msgid "Asks for a number of seconds back from the end of the recording which you want to synchronize with the Denemo Cursor. Use this to find and position a passage you have just recorded ready for transcribing."
msgstr "Prasa sekunžu skaitu atpakaļ no ieraksta beigām, ko vēlaties sinhronizēt ar Denemo kursoru. Izmantojiet to, lai atrastu un novietotu tikko ierakstītu fragmentu, kas gatavs pārrakstīšanai."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SyncRecordingToCursor.scm:4
msgid "No Recorded MIDI note is marked."
msgstr "Nav atzīmēta neviena ierakstīta MIDI nots."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SyncRecordingToCursor.xml.h:1
msgid "Synchronize Marked Recorded Midi Note to Denemo Cursor Position"
msgstr "Sinhronizēt atzīmēto ierakstīto MIDI noti ar Denemo kursora pozīciju"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/SyncRecordingToCursor.xml.h:2
msgid "Alters the timing of the recorded MIDI notes so that the marked note plays at the time of the note currently at the Denemo cursor."
msgstr "Maina ierakstīto MIDI nošu laikus tā, lai atzīmētā nots skanētu tās nots laikā, kas pašlaik atrodas pie Denemo kursora."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/ToggleHideOtherStaffsKeepingClick.xml.h:1
msgid "Hide Other Staffs (Off/On)"
msgstr "Slēpt citas nošu līnijas (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/ToggleHideOtherStaffsKeepingClick.xml.h:2
msgid "Hides/unhides other staffs in the display while keeping the MIDI track at the top visible."
msgstr "Slēpj/atklāj citas nošu līnijas attēlojumā, saglabājot redzamu MIDI celiņu augšā."

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/ToggleMuteClickTrack.xml.h:1
msgid "Unmute/Mute Recording Playback"
msgstr "Ieslēgt/apklusināt ieraksta atskaņošanu"

#: ../actions/menus/MainMenu/PlaybackMenu/Recording/ToggleMuteClickTrack.xml.h:2
msgid "Controls whether the recorded MIDI (and the click track) plays back with your score when you do Play."
msgstr "Nosaka, vai ierakstītais MIDI (un klikšķu celiņš) skan kopā ar jūsu partitūru, kad izmantojat Atskaņot."

#: ../actions/menus/MainMenu/PlaybackMenu/RecreateTimebase.xml.h:1
msgid "Create Timebase"
msgstr "Izveidot laika bāzi"

#: ../actions/menus/MainMenu/PlaybackMenu/RecreateTimebase.xml.h:2
msgid "Recalculates the timing of each note."
msgstr "Pārrēķina katras nots laiku."

#: ../actions/menus/MainMenu/PlaybackMenu/StopUnPause.xml.h:1
msgid "Stop/Forget Pause"
msgstr "Apturēt/aizmirst pauzi"

#: ../actions/menus/MainMenu/PlaybackMenu/StopUnPause.xml.h:2
msgid "Stops the playback or cancels the Pause, restoring the original start playback marker position."
msgstr "Aptur atskaņošanu vai atceļ pauzi, atjaunojot sākotnējo atskaņošanas sākuma marķiera pozīciju."

#. ToggleConduct
#: ../actions/menus/MainMenu/PlaybackMenu/ToggleConduct.xml.h:1
msgid "Mouse Conductor (Off/On)"
msgstr "Peles diriģents (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/ToggleConduct.xml.h:2
msgid "Turns on/off moving the playback on by moving the mouse over the score area."
msgstr "Ieslēdz/izslēdz atskaņošanas virzīšanu, pārvietojot peli virs partitūras apgabala."

#: ../actions/menus/MainMenu/PlaybackMenu/ToggleImmediatePlayback.xml.h:1
msgid "Toggle Immediate Playback"
msgstr "Pārslēgt tūlītēju atskaņošanu"

#: ../actions/menus/MainMenu/PlaybackMenu/ToggleImmediatePlayback.xml.h:2
msgid "Toggle on/off if you want to hear the note directly after inserting/changing."
msgstr "Ieslēgt/izslēgt, ja vēlaties dzirdēt noti tūlīt pēc ievietošanas/maiņas."

#. TogglePlayAlongPlayback
#: ../actions/menus/MainMenu/PlaybackMenu/TogglePlayAlongPlayback.xml.h:1
msgid "Play Along Playback (Off/On)"
msgstr "Spēlēšanas līdzi atskaņošana (izsl./iesl.)"

#: ../actions/menus/MainMenu/PlaybackMenu/TogglePlayAlongPlayback.xml.h:2
msgid "Turns off play along playback: when this is on the playback does not advance past the cursor unless you play along the correct note via Midi In."
msgstr "Izslēdz spēlēšanas līdzi atskaņošanu: kad tā ieslēgta, atskaņošana nevirzās tālāk par kursoru, ja vien caur MIDI ievadi nenospēlējat pareizo noti."

#: ../actions/menus/MainMenu/ViewMenu/DisplayCurrentObject.xml.h:2
msgid "Pops up a window which displays the object at the cursor, including anything attached to it."
msgstr "Atver logu, kurā attēlots objekts pie kursora, ieskaitot visu tam pievienoto."

#. DisplayEditingTime
#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.scm:2
msgid "This score has taken\n"
msgstr "Šīs partitūras izveide aizņēmusi\n"

#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.scm:2
msgid " to create, not counting unsaved edits."
msgstr " , neskaitot nesaglabātos labojumus."

#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.xml.h:1
msgid "Time Spent Editing"
msgstr "Rediģēšanā pavadītais laiks"

#: ../actions/menus/MainMenu/ViewMenu/DisplayEditingTime.xml.h:2
msgid "Displays the cumulative time spent editing this score. The time counts any period between starting to edit and saving to disk. The time is accumulated over different editing sessions."
msgstr "Parāda kopējo laiku, kas pavadīts, rediģējot šo partitūru. Laiks ietver jebkuru periodu starp rediģēšanas sākumu un saglabāšanu diskā. Laiks tiek uzkrāts vairākās rediģēšanas sesijās."

#. Choose Palette
#: ../actions/menus/MainMenu/ViewMenu/Palettes/ChoosePalette.xml.h:1
msgid "Select a Palette to Show"
msgstr "Izvēlieties rādāmo paleti"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/ChoosePalette.xml.h:2
msgid "Offers the available palettes to un-hide."
msgstr "Piedāvā pieejamās paletes atklāšanai."

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForChordType.scm:9
msgid "Create Palette Button"
msgstr "Izveidot paletes pogu"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForChordType.scm:9
msgid "Give a name for the chord"
msgstr "Ievadiet akorda nosaukumu"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForChordType.scm:18
msgid "Not on a chord"
msgstr "Nav uz akorda"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForChordType.xml.h:1
msgid "Create Button for Chord Type"
msgstr "Izveidot pogu akorda tipam"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForChordType.xml.h:2
msgid "Creates a palette button which will insert the type of chord at the cursor, transposed to the cursor position when invoked. Use prepending sharp or flat to insert a chord with sharpened or flattened root note. Use for chord symbol chords."
msgstr "Izveido paletes pogu, kas ievietos akorda pie kursora tipu, izsaucot transponētu uz kursora pozīciju. Lai ievietotu akordu ar paaugstinātu vai pazeminātu pamatskaņu, priekšā pievienojiet diēzu vai bemolu. Izmantojiet akordu simbolu akordiem."

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:127
#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:129
msgid "Object Clone"
msgstr "Objekta klons"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:127
msgid "Give (unique) label for button: "
msgstr "Ievadiet pogas (unikālu) apzīmējumu: "

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:127
msgid "mylabel"
msgstr "manaapzīme"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:129
msgid "Give tooltip for button: "
msgstr "Ievadiet pogas rīka padomu: "

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:129
msgid "Inserts object"
msgstr "Ievieto objektu"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:133
msgid "Failed - duplicate label, no palette?"
msgstr "Neizdevās — dublēts apzīmējums, nav paletes?"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.scm:134
msgid "Not implemented yet"
msgstr "Vēl nav realizēts"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.xml.h:1
msgid "Create Button for Object"
msgstr "Izveidot pogu objektam"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/CreateButtonForObject.xml.h:2
msgid "Creates a palette button to insert a clone of the object at the cursor when the button is pressed."
msgstr "Izveido paletes pogu, kas, to nospiežot, ievieto objekta pie kursora klonu."

#: ../actions/menus/MainMenu/ViewMenu/Palettes/UnhidePalettes.xml.h:1
msgid "Show Hidden Palettes"
msgstr "Rādīt paslēptās paletes"

#: ../actions/menus/MainMenu/ViewMenu/Palettes/UnhidePalettes.xml.h:2
msgid "Un-hides all non-empty palettes."
msgstr "Atklāj visas netukšās paletes."

#: ../actions/menus/MainMenu/ViewMenu/ShowLastChange.scm:4
msgid "The last change was:\n"
msgstr "Pēdējā izmaiņa bija:\n"

