msgstr "Ievieto jaunu nošu līniju partitūras augšā"

#: ../src/core/entries.h:284
msgid "Add Last Staff"
msgstr "Pievienot pēdējo nošu līniju"

#: ../src/core/entries.h:284
msgid "Inserts a new staff at the end of the score"
msgstr "Ievieto jaunu nošu līniju partitūras beigās"

#: ../src/core/entries.h:285
msgid "Delete Staff Before"
msgstr "Dzēst iepriekšējo nošu līniju"

#: ../src/core/entries.h:285
msgid "Deletes the staff before the current staff"
msgstr "Dzēš nošu līniju pirms pašreizējās nošu līnijas"

#: ../src/core/entries.h:286
#: ../actions/menus/ObjectMenu/StaffMenu/DeleteCurrentStaff.scm:2
msgid "Delete Current Staff"
msgstr "Dzēst pašreizējo nošu līniju"

#: ../src/core/entries.h:286
msgid "Deletes the current staff"
msgstr "Dzēš pašreizējo nošu līniju"

#: ../src/core/entries.h:287
msgid "Delete Staff After"
msgstr "Dzēst nākamo nošu līniju"

#: ../src/core/entries.h:287
msgid "Deletes the staff after the current staff"
msgstr "Dzēš nošu līniju pēc pašreizējās nošu līnijas"

#: ../src/core/entries.h:288
#: ../actions/menus/ObjectMenu/StaffMenu/Voices/NewVoice.xml.h:1
msgid "Add Voice"
msgstr "Pievienot balsi"

#: ../src/core/entries.h:288
msgid "Adds a new voice (part), to the current staff. It is tricky to switch between the voices. Suggest to use merge staffs"
msgstr "Pievieno pašreizējai nošu līnijai jaunu balsi (partiju). Pārslēgties starp balsīm ir sarežģīti. Ieteicams izmantot nošu līniju apvienošanu"

#: ../src/core/entries.h:289 ../actions/denemo.scm:1542
msgid "Built-in Staff Properties"
msgstr "Iebūvētās nošu līnijas īpašības"

#: ../src/core/entries.h:289
msgid "Change the built-in properties of the current staff"
msgstr "Mainīt pašreizējās nošu līnijas iebūvētās īpašības"

#: ../src/core/entries.h:290
msgid "InsertMenu"
msgstr "InsertMenu"

#: ../src/core/entries.h:290 ../src/core/entries.h:352
#: ../src/core/entries.h:387 ../src/ui/markup.c:659
msgid "Insert"
msgstr "Ievietot"

#: ../src/core/entries.h:291
msgid ""
"Menu:\n"
"Clef"
msgstr ""
"Izvēlne:\n"
"Atslēga"

#: ../src/core/entries.h:292
msgid "Initial Clef"
msgstr "Sākotnējā atslēga"

#: ../src/core/entries.h:292
