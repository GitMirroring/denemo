msgid "Checking Chords Filter"
msgstr "Akordu pārbaudes filtrs"

#: ../actions/menus/MainMenu/InputMenu/MIDI/ToggleCheckChords.scm:101
msgid "Note played was "
msgstr "Nospēlētā nots bija "

#: ../actions/menus/MainMenu/InputMenu/MIDI/ToggleCheckChords.scm:101
